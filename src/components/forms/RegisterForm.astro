---
/**
 * RegisterForm - Guided Two-Step Registration Wizard for MarkChat SaaS
 *
 * Implemented using native Virex semantic design tokens and layout conventions.
 * Features:
 * - Step 1: Google OAuth option, organization details, and verified six-digit email OTP
 * - Step 2: Account security & Plan selection with NIST SP 800-63B password entropy and tabular-nums KES pricing
 * - Step navigation with complete state preservation
 * - Live trial/payment policy, bounded provisioning, and authenticated session exchange
 * - Open-redirect protection (CWE-601), rate-limit handling (HTTP 429), and honeypot anti-spam defense
 * - Zero premature validation errors on initial load
 */
import SocialAuthButtons from './SocialAuthButtons.astro';
import { primaryCtaClasses } from '@/lib/cta-classes';

interface Props {
  action?: string;
  method?: 'POST' | 'GET';
  defaultPlanId?: string;
  billingInterval?: 'monthly' | 'annual';
  redirectUrl?: string;
}

const {
  action = '',
  method = 'POST',
  defaultPlanId = 'growth',
  billingInterval = 'monthly',
  redirectUrl = '/billing',
} = Astro.props;

const controlPlaneUrl =
  import.meta.env.PUBLIC_CONTROL_PLANE_URL ||
  import.meta.env.PUBLIC_CONTROL_PLANE_API_URL ||
  'http://localhost:5000';
---

<div class="w-full">
  <!-- ===================================================================== -->
  <!-- STEP PROGRESS INDICATOR                                               -->
  <!-- ===================================================================== -->
  <div class="mb-6" aria-label="Registration Progress">
    <div class="flex items-center justify-between mb-2">
      <!-- Step 1 Pill -->
      <button
        type="button"
        id="step-1-indicator"
        class="flex items-center gap-2 text-xs font-semibold text-primary transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary rounded px-1.5 py-0.5 cursor-pointer"
        aria-current="step"
      >
        <span
          id="step-1-badge"
          class="w-6 h-6 rounded-full bg-primary text-white flex items-center justify-center text-xs font-bold shadow-xs"
        >
          1
        </span>
        <span class="hidden sm:inline text-text">Organization details</span>
      </button>

      <!-- Connecting Progress Line -->
      <div class="flex-1 mx-3 sm:mx-4 h-1 bg-border rounded-full overflow-hidden">
        <div id="step-progress-bar" class="h-full bg-primary transition-all duration-300 w-1/2">
        </div>
      </div>

      <!-- Step 2 Pill -->
      <button
        type="button"
        id="step-2-indicator"
        class="flex items-center gap-2 text-xs font-medium text-text-muted transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary rounded px-1.5 py-0.5 cursor-pointer"
      >
        <span
          id="step-2-badge"
          class="w-6 h-6 rounded-full bg-surface border border-border text-text-muted flex items-center justify-center text-xs font-bold"
        >
          2
        </span>
        <span class="hidden sm:inline">Security & plan</span>
      </button>
    </div>

    <!-- Mobile Step Name Label -->
    <div class="text-xs font-medium text-text-muted sm:hidden text-center mt-1">
      <span id="mobile-step-label">Step 1 of 2: Organization details</span>
    </div>
  </div>

  <!-- ===================================================================== -->
  <!-- REGISTRATION FORM (Single Form Preserving Full State)                  -->
  <!-- ===================================================================== -->
  <form
    id="register-form"
    action={action}
    method={method}
    class="space-y-4"
    data-redirect={redirectUrl}
    data-api-url={controlPlaneUrl}
    aria-busy="false"
    novalidate
  >
    <!-- Honeypot field for anti-bot defense -->
    <div class="hidden" aria-hidden="true">
      <label>
        Don't fill this out if you're human:
        <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" />
      </label>
    </div>

    <!-- Hidden plan input -->
    <input type="hidden" id="planId" name="planId" value={defaultPlanId} />
    <input type="hidden" id="billingInterval" name="billingInterval" value={billingInterval} />

    <!-- =================================================================== -->
    <!-- STEP 1: ORGANIZATION & ADMIN DETAILS                                -->
    <!-- =================================================================== -->
    <div id="step-1-container" class="space-y-4 transition-opacity duration-150">
      <!-- Federated Google Sign-Up -->
      <SocialAuthButtons variant="register" dividerText="Or register with email" />

      <div class="border-b border-border pb-2.5">
        <h2 class="text-sm font-semibold text-text">Organization details</h2>
        <p class="text-xs text-text-muted mt-0.5">
          Provide your business details and verify the administrator email for your workspace.
        </p>
      </div>

      <!-- Business / Organization Name field -->
      <div>
        <label for="businessName" class="block text-sm font-medium text-text mb-1.5">
          Organization / business name <span class="text-error" aria-hidden="true">*</span>
        </label>
        <input
          type="text"
          id="businessName"
          maxlength="255"
          name="businessName"
          required
          minlength="2"
          autocomplete="organization"
          aria-describedby="businessName-error"
          aria-invalid="false"
          class="w-full h-11 px-4 rounded-xl border border-border bg-background text-text placeholder:text-text-muted/60 focus:outline-none focus-visible:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 focus-visible:ring-2 focus-visible:ring-primary transition-colors text-sm shadow-xs"
          placeholder="e.g. Acme Retail Kenya Ltd"
        />
        <div
          class="mt-1.5 flex items-center gap-1.5 text-xs text-text-muted font-mono tabular-nums"
        >
          <span>Workspace URL:</span>
          <span id="workspace-slug-preview" class="text-text-muted/70 font-medium transition-colors"
            >https://your-workspace.markchat.co.ke</span
          >
        </div>
        <p
          id="businessName-error"
          class="mt-1 text-xs text-error hidden"
          data-error="businessName"
          role="alert"
        >
        </p>
      </div>

      <!-- Administrator Full Name field -->
      <div>
        <label for="fullName" class="block text-sm font-medium text-text mb-1.5">
          Administrator full name <span class="text-error" aria-hidden="true">*</span>
        </label>
        <input
          type="text"
          id="fullName"
          maxlength="255"
          name="fullName"
          required
          minlength="2"
          autocomplete="name"
          aria-describedby="fullName-error"
          aria-invalid="false"
          class="w-full h-11 px-4 rounded-xl border border-border bg-background text-text placeholder:text-text-muted/60 focus:outline-none focus-visible:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 focus-visible:ring-2 focus-visible:ring-primary transition-colors text-sm shadow-xs"
          placeholder="e.g. Wanjiku Kimani"
        />
        <p
          id="fullName-error"
          class="mt-1 text-xs text-error hidden"
          data-error="fullName"
          role="alert"
        >
        </p>
      </div>

      <!-- Business Email Address field -->
      <div>
        <label for="registerEmail" class="block text-sm font-medium text-text mb-1.5">
          Business email address <span class="text-error" aria-hidden="true">*</span>
        </label>
        <input
          type="email"
          id="registerEmail"
          maxlength="254"
          name="email"
          required
          autocomplete="email"
          aria-describedby="registerEmail-error"
          aria-invalid="false"
          class="w-full h-11 px-4 rounded-xl border border-border bg-background text-text placeholder:text-text-muted/60 focus:outline-none focus-visible:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 focus-visible:ring-2 focus-visible:ring-primary transition-colors text-sm shadow-xs"
          placeholder="wanjiku@acmeretail.co.ke"
        />
        <p
          id="registerEmail-error"
          class="mt-1 text-xs text-error hidden"
          data-error="registerEmail"
          role="alert"
        >
        </p>
      </div>

      <div class="rounded-xl border border-border bg-background p-3.5 space-y-3">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <div>
            <p class="text-xs font-semibold text-text">Verify your email</p>
            <p class="text-xs text-text-muted mt-0.5">We will email you a six-digit code.</p>
          </div>
          <button
            type="button"
            id="send-email-otp"
            class="h-9 px-3 rounded-lg border border-primary text-primary text-xs font-medium hover:bg-primary/5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary disabled:opacity-50 disabled:cursor-not-allowed cursor-pointer"
            disabled
          >
            Send verification code
          </button>
        </div>
        <div id="email-otp-entry" class="hidden space-y-2">
          <label for="emailOtpCode" class="block text-xs font-medium text-text"
            >Email verification code</label
          >
          <div class="flex items-center gap-2">
            <input
              type="text"
              id="emailOtpCode"
              name="emailOtpCode"
              inputmode="numeric"
              autocomplete="one-time-code"
              pattern="[0-9]{6}"
              maxlength="6"
              aria-describedby="email-otp-status email-otp-error"
              class="min-w-0 flex-1 h-10 px-3 rounded-xl border border-border bg-background text-text font-mono tracking-widest tabular-nums focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 text-sm"
              placeholder="123456"
            />
            <button
              type="button"
              id="verify-email-otp"
              class:list={[
                'h-10 px-4 rounded-xl text-xs font-medium disabled:opacity-50 disabled:cursor-not-allowed cursor-pointer',
                primaryCtaClasses,
              ]}>Verify code</button
            >
          </div>
        </div>
        <p id="email-otp-status" class="text-xs text-text-muted" role="status" aria-live="polite">
        </p>
        <p id="email-otp-error" class="hidden text-xs text-error" role="alert"></p>
      </div>

      <!-- Phone Number field -->
      <div>
        <div class="flex items-center justify-between mb-1.5">
          <label for="registerPhone" class="block text-sm font-medium text-text">
            Phone number
          </label>
          <span class="text-[11px] text-text-muted">For M-Pesa and account updates</span>
        </div>
        <input
          type="tel"
          id="registerPhone"
          maxlength="50"
          name="phone"
          autocomplete="tel"
          aria-describedby="registerPhone-error"
          aria-invalid="false"
          class="w-full h-11 px-4 rounded-xl border border-border bg-background text-text placeholder:text-text-muted/60 focus:outline-none focus-visible:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 focus-visible:ring-2 focus-visible:ring-primary transition-colors text-sm shadow-xs"
          placeholder="+254 712 345 678"
        />
        <p
          id="registerPhone-error"
          class="mt-1 text-xs text-error hidden"
          data-error="registerPhone"
          role="alert"
        >
        </p>
      </div>

      <!-- Step 1 Continue Action -->
      <div class="pt-2">
        <button
          type="button"
          id="btn-continue-step1"
          class:list={[
            'w-full h-11 cursor-pointer px-6 rounded-xl font-medium text-sm focus-visible:ring-offset-background flex items-center justify-center gap-2 group',
            primaryCtaClasses,
          ]}
        >
          <span>Continue to account setup</span>
          <svg
            class="w-4 h-4 group-hover:translate-x-0.5 transition-transform"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
          </svg>
        </button>
      </div>
    </div>

    <!-- =================================================================== -->
    <!-- STEP 2: SECURITY, PLAN CONFIRMATION & SUBMIT                       -->
    <!-- =================================================================== -->
    <div id="step-2-container" class="space-y-4 hidden transition-opacity duration-150">
      <div class="border-b border-border pb-2.5 flex items-center justify-between">
        <div>
          <h2 class="text-sm font-semibold text-text">Account security & plan</h2>
          <p class="text-xs text-text-muted mt-0.5">
            Configure your master password and confirm subscription terms.
          </p>
        </div>
        <button
          type="button"
          id="btn-back-header"
          class="text-xs text-primary hover:text-primary-dark hover:underline flex items-center gap-1 cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary rounded px-1.5 py-0.5"
        >
          ← Back
        </button>
      </div>

      <!-- Password field with visibility toggle & entropy meter -->
      <div>
        <label for="registerPassword" class="block text-sm font-medium text-text mb-1.5">
          Password <span class="text-error" aria-hidden="true">*</span>
        </label>
        <div class="relative">
          <input
            type="password"
            id="registerPassword"
            maxlength="255"
            name="password"
            required
            minlength="8"
            autocomplete="new-password"
            aria-describedby="registerPassword-error"
            aria-invalid="false"
            class="w-full h-11 px-4 pr-11 rounded-xl border border-border bg-background text-text placeholder:text-text-muted/60 focus:outline-none focus-visible:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 focus-visible:ring-2 focus-visible:ring-primary transition-colors text-sm shadow-xs"
            placeholder="••••••••••••"
          />
          <button
            type="button"
            id="toggle-register-password"
            class="absolute inset-y-0 right-0 pr-3.5 flex items-center text-text-muted hover:text-text cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary rounded my-1.5 mr-1"
            aria-label="Show password"
            aria-pressed="false"
          >
            <svg
              id="eye-icon-reg"
              class="w-4 h-4"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"
              ></path>
            </svg>
          </button>
        </div>

        <!-- NIST SP 800-63B Entropy Indicator -->
        <div id="password-strength-container" class="mt-2 space-y-1.5 hidden" aria-live="polite">
          <div class="flex items-center justify-between text-xs">
            <span class="text-text-muted">Password strength:</span>
            <span id="password-strength-label" class="font-medium text-text">Weak</span>
          </div>
          <div class="grid grid-cols-3 gap-1.5 h-1 w-full bg-border rounded-full overflow-hidden">
            <div id="strength-bar-1" class="h-full rounded-full bg-error transition-colors"></div>
            <div id="strength-bar-2" class="h-full rounded-full bg-border transition-colors"></div>
            <div id="strength-bar-3" class="h-full rounded-full bg-border transition-colors"></div>
          </div>
        </div>

        <p class="mt-1 text-xs text-text-muted">
          Min 8 characters (10+ recommended). Avoid common phrases.
        </p>
        <p
          id="registerPassword-error"
          class="mt-1 text-xs text-error hidden"
          data-error="registerPassword"
          role="alert"
        >
        </p>
      </div>

      <!-- Password Confirmation field -->
      <div>
        <label for="confirmPassword" class="block text-sm font-medium text-text mb-1.5">
          Confirm password <span class="text-error" aria-hidden="true">*</span>
        </label>
        <input
          type="password"
          id="confirmPassword"
          maxlength="255"
          name="confirmPassword"
          required
          minlength="8"
          autocomplete="new-password"
          aria-describedby="confirmPassword-error"
          aria-invalid="false"
          class="w-full h-11 px-4 rounded-xl border border-border bg-background text-text placeholder:text-text-muted/60 focus:outline-none focus-visible:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 focus-visible:ring-2 focus-visible:ring-primary transition-colors text-sm shadow-xs"
          placeholder="••••••••••••"
        />
        <p
          id="confirmPassword-error"
          class="mt-1 text-xs text-error hidden"
          data-error="confirmPassword"
          role="alert"
        >
        </p>
      </div>

      <!-- Plan Selection Cards -->
      <div>
        <label class="block text-sm font-medium text-text mb-2"> Selected subscription plan </label>
        <div
          class="grid grid-cols-1 sm:grid-cols-3 gap-2.5"
          role="radiogroup"
          aria-label="Subscription Plans"
        >
          <!-- Starter Plan -->
          <div
            class="plan-card cursor-pointer p-3 rounded-xl border border-border bg-background hover:bg-surface transition-all"
            data-plan="starter"
            tabindex="0"
            role="radio"
            aria-checked="false"
          >
            <div class="flex items-center justify-between">
              <span class="font-medium text-xs text-text">Starter</span>
              <span class="text-[10px] text-text-muted">3 Agents</span>
            </div>
            <div class="mt-1 font-semibold text-sm text-text tabular-nums">KES 1,500/mo</div>
            <div class="text-[10px] text-text-muted mt-0.5">2 Inboxes</div>
          </div>

          <!-- Growth Plan -->
          <div
            class="plan-card cursor-pointer p-3 rounded-xl border-2 border-primary bg-primary/5 transition-all shadow-xs"
            data-plan="growth"
            tabindex="0"
            role="radio"
            aria-checked="true"
          >
            <div class="flex items-center justify-between">
              <span class="font-semibold text-xs text-text">Growth</span>
              <span
                id="registration-trial-badge"
                class="hidden text-[9px] px-1.5 py-0.5 rounded bg-primary text-white font-medium"
                >Trial</span
              >
            </div>
            <div class="mt-1 font-bold text-sm text-text tabular-nums">KES 3,500/mo</div>
            <div class="text-[10px] text-text-muted mt-0.5" id="registration-trial-label">
              Checking trial availability...
            </div>
          </div>

          <!-- Scale Plan -->
          <div
            class="plan-card cursor-pointer p-3 rounded-xl border border-border bg-background hover:bg-surface transition-all"
            data-plan="scale"
            tabindex="0"
            role="radio"
            aria-checked="false"
          >
            <div class="flex items-center justify-between">
              <span class="font-medium text-xs text-text">Scale</span>
              <span class="text-[10px] text-text-muted">25 Agents</span>
            </div>
            <div class="mt-1 font-semibold text-sm text-text tabular-nums">KES 5,000/mo</div>
            <div class="text-[10px] text-text-muted mt-0.5">Unlimited Inboxes</div>
          </div>
        </div>
      </div>

      <!-- Terms & Privacy Agreement checkbox -->
      <div class="pt-1">
        <label class="flex items-start cursor-pointer select-none">
          <input
            type="checkbox"
            id="agreeTerms"
            name="agreeTerms"
            required
            class="h-4 w-4 mt-0.5 rounded border-border bg-background text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary cursor-pointer shrink-0"
          />
          <span class="ml-2.5 text-xs text-text-muted leading-relaxed">
            I agree to MarkChat's{' '}
            <a href="/terms" target="_blank" class="text-primary hover:underline"
              >Terms of Service</a
            >
            {' '}and{' '}
            <a href="/privacy" target="_blank" class="text-primary hover:underline"
              >Privacy Policy</a
            >. I acknowledge Kenya Data Protection Act (KDPA 2019) compliance requirements.
          </span>
        </label>
        <p
          id="agreeTerms-error"
          class="mt-1 text-xs text-error hidden"
          data-error="agreeTerms"
          role="alert"
        >
        </p>
      </div>

      <!-- Navigation & Submit Controls for Step 2 -->
      <div class="flex items-center gap-3 pt-2">
        <button
          type="button"
          id="btn-back-step2"
          class="h-11 px-4 rounded-xl border border-border bg-background hover:bg-surface text-text font-medium text-sm transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary cursor-pointer"
        >
          Back
        </button>

        <button
          type="submit"
          id="register-submit-button"
          class:list={[
            'flex-1 h-11 cursor-pointer px-6 rounded-xl font-medium text-sm focus-visible:ring-offset-background disabled:opacity-50 disabled:cursor-not-allowed flex items-center justify-center gap-2',
            primaryCtaClasses,
          ]}
        >
          <span id="register-button-text"> Create MarkChat Account </span>
          <span id="register-button-loading" class="hidden items-center gap-2">
            <svg
              class="animate-spin w-4 h-4 text-white"
              fill="none"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <circle
                class="opacity-25"
                cx="12"
                cy="12"
                r="10"
                stroke="currentColor"
                stroke-width="4"></circle>
              <path
                class="opacity-75"
                fill="currentColor"
                d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
              ></path>
            </svg>
            <span id="register-loading-status">Provisioning workspace...</span>
          </span>
        </button>
      </div>
    </div>

    <div
      class="rounded-xl border border-border bg-background p-3.5 text-xs text-text-muted leading-relaxed"
      role="status"
      aria-live="polite"
    >
      <p id="registration-policy">Checking the current trial and payment terms...</p>
      <button
        id="retry-registration-options"
        type="button"
        class="hidden mt-2 text-primary underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary rounded cursor-pointer"
        >Retry loading registration terms</button
      >
    </div>
    <a
      id="registration-payment-return"
      href="/billing/return"
      class="hidden text-sm text-primary underline mt-2"
    >
      Check an earlier registration payment
    </a>
    <a id="registration-sign-in" href="/login" class="hidden text-sm text-primary underline"
      >Sign in to your workspace</a
    >
    <button
      id="resume-registration"
      type="button"
      class="hidden text-sm text-primary underline cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary rounded"
      >Continue workspace setup</button
    >
    <button
      id="retry-registration-payment"
      type="button"
      class="hidden text-sm text-primary underline cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary rounded disabled:opacity-50"
      >Retry payment</button
    >

    <!-- Status Messages Container -->
    <div id="register-form-status" class="hidden" role="alert" aria-live="polite">
      <!-- Success State -->
      <div
        id="register-form-success"
        class="hidden p-3.5 rounded-lg bg-success-bg border border-success text-success text-sm"
      >
        <p class="font-semibold flex items-center gap-2">
          <svg
            class="w-4 h-4 text-success shrink-0"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"
            ></path>
          </svg>
          Workspace ready!
        </p>
        <p class="text-xs mt-0.5">Redirecting to your new dashboard...</p>
      </div>

      <!-- Error State -->
      <div
        id="register-form-error"
        class="hidden p-3.5 rounded-lg bg-error-bg border border-error text-error text-sm"
      >
        <p class="font-semibold flex items-center gap-2">
          <svg
            class="w-4 h-4 text-error shrink-0"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
            ></path>
          </svg>
          Registration failed
        </p>
        <p id="register-error-text" class="text-xs mt-0.5 leading-relaxed">
          An error occurred during workspace creation. Please check your details and try again.
        </p>
      </div>
    </div>
  </form>
</div>

<script>
  import { customerDestination, persistCustomerSession } from '@/lib/customer-session';
  import {
    EmailVerification,
    RegistrationError,
    clearPendingRegistrationPayment,
    clearRegistrationResume,
    obtainRegistrationSession,
    fetchRegistrationOptions,
    formatTrialDuration,
    readPendingRegistrationPayment,
    readRegistrationResume,
    registrationPaymentRequired,
    registrationPasswordError,
    registrationRequest,
    saveRegistrationResume,
    type RegistrationOptions,
    type RegistrationResume,
    type RegistrationPaymentPurpose,
  } from '@/lib/registration-client';
  import { prepareRegistrationPayment } from '@/lib/registration-payment';

  const form = document.getElementById('register-form') as HTMLFormElement;
  const step1Container = document.getElementById('step-1-container');
  const step2Container = document.getElementById('step-2-container');
  const btnContinueStep1 = document.getElementById('btn-continue-step1');
  const btnBackStep2 = document.getElementById('btn-back-step2');
  const btnBackHeader = document.getElementById('btn-back-header');
  const step1Indicator = document.getElementById('step-1-indicator');
  const step2Indicator = document.getElementById('step-2-indicator');
  const step1Badge = document.getElementById('step-1-badge');
  const step2Badge = document.getElementById('step-2-badge');
  const progressBar = document.getElementById('step-progress-bar');
  const mobileStepLabel = document.getElementById('mobile-step-label');

  const businessNameInput = document.getElementById('businessName') as HTMLInputElement;
  const workspaceSlugPreview = document.getElementById('workspace-slug-preview');
  const passwordInput = document.getElementById('registerPassword') as HTMLInputElement;
  const confirmPasswordInput = document.getElementById('confirmPassword') as HTMLInputElement;
  const toggleBtn = document.getElementById('toggle-register-password');

  const strengthContainer = document.getElementById('password-strength-container');
  const strengthLabel = document.getElementById('password-strength-label');
  const strengthBar1 = document.getElementById('strength-bar-1');
  const strengthBar2 = document.getElementById('strength-bar-2');
  const strengthBar3 = document.getElementById('strength-bar-3');

  const submitButton = document.getElementById('register-submit-button') as HTMLButtonElement;
  const buttonText = document.getElementById('register-button-text');
  const buttonLoading = document.getElementById('register-button-loading');
  const loadingStatus = document.getElementById('register-loading-status');
  const formStatus = document.getElementById('register-form-status');
  const formSuccess = document.getElementById('register-form-success');
  const formError = document.getElementById('register-form-error');
  const planInput = document.getElementById('planId') as HTMLInputElement;
  const emailInput = document.getElementById('registerEmail') as HTMLInputElement;
  const otpCodeInput = document.getElementById('emailOtpCode') as HTMLInputElement;
  const sendOtpButton = document.getElementById('send-email-otp') as HTMLButtonElement;
  const verifyOtpButton = document.getElementById('verify-email-otp') as HTMLButtonElement;
  const otpEntry = document.getElementById('email-otp-entry');
  const otpStatus = document.getElementById('email-otp-status');
  const otpError = document.getElementById('email-otp-error');
  const policyText = document.getElementById('registration-policy');
  const retryOptionsButton = document.getElementById(
    'retry-registration-options'
  ) as HTMLButtonElement;
  const resumeButton = document.getElementById('resume-registration') as HTMLButtonElement;
  const retryPaymentButton = document.getElementById(
    'retry-registration-payment'
  ) as HTMLButtonElement;
  const apiUrl = form?.dataset.apiUrl || 'http://localhost:5000';
  const emailVerification = new EmailVerification(apiUrl);
  let registrationOptions: RegistrationOptions | null = null;
  let currentRegistration: RegistrationResume | null = readRegistrationResume();
  let submitting = false;
  let otpAction: 'send' | 'verify' | null = null;
  let wasVerified = false;

  // Track touched fields to strictly prevent premature errors on initial load
  const touchedFields = new Set<string>();

  // Surface OAuth Errors Gracefully
  const initialParams = new URLSearchParams(window.location.search);
  const oauthError = initialParams.get('oauth_error');
  if (oauthError) {
    let message = 'Google authentication could not be completed. Please try again.';
    if (oauthError === 'google_not_configured') {
      message =
        'Google Sign-In is not configured on this environment yet. Please register with your details below.';
    } else if (oauthError === 'access_denied') {
      message = 'Google sign-up was canceled.';
    } else if (oauthError.toUpperCase() === 'GOOGLE_SIGNUP_EMAIL_VERIFICATION_REQUIRED') {
      message =
        'To create a new workspace, verify your email with the six-digit code below. Existing customers can still sign in with Google.';
    }
    showFormError(message);
    initialParams.delete('oauth_error');
    const cleanSearch = initialParams.toString();
    const cleanUrl =
      window.location.pathname + (cleanSearch ? `?${cleanSearch}` : '') + window.location.hash;
    window.history.replaceState({}, document.title, cleanUrl);
  }

  // Plan metadata
  const plansMap: Record<string, { name: string }> = {
    starter: { name: 'Starter' },
    growth: { name: 'Growth' },
    scale: { name: 'Scale' },
  };

  // Plan selection cards
  const planCards = document.querySelectorAll('.plan-card');
  planCards.forEach((card) => {
    card.addEventListener('click', () => {
      const selected = card.getAttribute('data-plan') || 'growth';
      selectPlan(selected);
    });
    card.addEventListener('keydown', (e) => {
      const keyboardEvent = e as KeyboardEvent;
      if (keyboardEvent.key === 'Enter' || keyboardEvent.key === ' ') {
        e.preventDefault();
        const selected = card.getAttribute('data-plan') || 'growth';
        selectPlan(selected);
      }
    });
  });

  function selectPlan(planId: string) {
    if (submitting) return;
    if (planInput) planInput.value = planId;
    planCards.forEach((c) => {
      const isSelected = c.getAttribute('data-plan') === planId;
      c.setAttribute('aria-checked', isSelected ? 'true' : 'false');
      if (isSelected) {
        c.className =
          'plan-card cursor-pointer p-3 rounded-xl border-2 border-primary bg-primary/5 transition-all shadow-xs';
      } else {
        c.className =
          'plan-card cursor-pointer p-3 rounded-xl border border-border bg-background hover:bg-surface transition-all';
      }
    });

    if (buttonText) {
      buttonText.textContent = 'Create MarkChat Account';
    }
  }

  // Resume an unfinished registration after returning from checkout, without re-submitting.
  const pendingRegistration = readPendingRegistrationPayment();
  if (pendingRegistration) {
    document.getElementById('registration-payment-return')?.classList.remove('hidden');
  }
  if (currentRegistration) resumeButton?.classList.remove('hidden');

  // Synchronize plan from URL query param if present
  const urlParams = new URLSearchParams(window.location.search);
  const planParam = urlParams.get('plan')?.toLowerCase();
  if (planParam && plansMap[planParam]) {
    selectPlan(planParam);
  }
  if (urlParams.get('interval') === 'annual') {
    (document.getElementById('billingInterval') as HTMLInputElement).value = 'annual';
  }

  function showOtpError(message: string) {
    if (otpError) {
      otpError.textContent = message;
      otpError.classList.remove('hidden');
    }
    otpCodeInput?.setAttribute('aria-invalid', 'true');
  }

  function updateOtpUi() {
    const verified = !!emailVerification.token;
    const cooldown = emailVerification.resendSeconds;
    sendOtpButton.disabled =
      submitting || !registrationOptions || emailVerification.busy || cooldown > 0 || verified;
    sendOtpButton.textContent = verified
      ? 'Email verified'
      : otpAction === 'send'
        ? 'Sending code...'
        : cooldown > 0
          ? `Resend in ${cooldown}s`
          : emailVerification.hasChallenge
            ? 'Resend code'
            : 'Send verification code';
    verifyOtpButton.disabled =
      submitting || emailVerification.busy || !emailVerification.hasChallenge || verified;
    verifyOtpButton.textContent = otpAction === 'verify' ? 'Verifying...' : 'Verify code';
    otpCodeInput.disabled = submitting || verified;
    otpEntry?.classList.toggle('hidden', !emailVerification.hasChallenge || verified);
    if (wasVerified && !verified && otpStatus)
      otpStatus.textContent = 'Email verification expired. Request a new code before continuing.';
    wasVerified = verified;
    if (!submitting) submitButton.disabled = !registrationOptions || !verified;
  }

  emailInput?.addEventListener('input', () => {
    const previousEmail = emailVerification.email;
    emailVerification.setEmail(emailInput.value);
    if (previousEmail !== emailVerification.email) {
      otpCodeInput.value = '';
      if (otpStatus) otpStatus.textContent = '';
      otpError?.classList.add('hidden');
      otpCodeInput.removeAttribute('aria-invalid');
      wasVerified = false;
    }
    updateOtpUi();
  });
  otpCodeInput?.addEventListener('input', () => {
    otpCodeInput.value = otpCodeInput.value.replace(/\D/g, '').slice(0, 6);
    otpError?.classList.add('hidden');
    otpCodeInput.removeAttribute('aria-invalid');
  });
  otpCodeInput?.addEventListener('keydown', (event) => {
    if (event.key === 'Enter') {
      event.preventDefault();
      verifyOtpButton.click();
    }
  });
  sendOtpButton?.addEventListener('click', async () => {
    if (submitting || !registrationOptions) return;
    emailVerification.setEmail(emailInput.value);
    touchedFields.add('registerEmail');
    if (!validateField('registerEmail', true)) {
      emailInput.focus();
      return;
    }
    otpError?.classList.add('hidden');
    otpAction = 'send';
    try {
      const sending = emailVerification.send();
      updateOtpUi();
      await sending;
      if (otpStatus)
        otpStatus.textContent = `A six-digit code was sent to ${emailVerification.email}. Check your inbox and spam folder.`;
      otpCodeInput.value = '';
    } catch (error) {
      showOtpError(
        error instanceof Error ? error.message : 'We could not send your email code. Please retry.'
      );
    } finally {
      otpAction = null;
      updateOtpUi();
      if (emailVerification.hasChallenge) otpCodeInput.focus();
    }
  });
  verifyOtpButton?.addEventListener('click', async () => {
    if (submitting) return;
    emailVerification.setEmail(emailInput.value);
    otpError?.classList.add('hidden');
    otpAction = 'verify';
    try {
      const verifying = emailVerification.verify(otpCodeInput.value.trim());
      updateOtpUi();
      await verifying;
      if (otpStatus) otpStatus.textContent = 'Your email is verified. Continue to account setup.';
      otpCodeInput.removeAttribute('aria-invalid');
    } catch (error) {
      showOtpError(
        error instanceof Error ? error.message : 'The code could not be verified. Please retry.'
      );
    } finally {
      otpAction = null;
      updateOtpUi();
    }
  });

  async function loadRegistrationOptions() {
    retryOptionsButton.disabled = true;
    try {
      registrationOptions = await fetchRegistrationOptions(apiUrl);
      const duration = formatTrialDuration(registrationOptions.trialHours);
      const trialLabel = document.getElementById('registration-trial-label');
      if (trialLabel)
        trialLabel.textContent = duration ? `${duration} free trial` : 'Paid subscription required';
      document.getElementById('registration-trial-badge')?.classList.toggle('hidden', !duration);
      const fee = new Intl.NumberFormat('en-KE', {
        style: 'currency',
        currency: 'KES',
        maximumFractionDigits: 2,
      }).format(registrationOptions.verificationAmountKesCents / 100);
      const trialCopy = duration
        ? `Your selected plan includes a ${duration} free trial.`
        : 'No free trial is configured. A paid subscription is required before workspace activation.';
      const paymentCopy = registrationOptions.verificationRequired
        ? ` A refundable ${fee} account confirmation is required${duration ? ' before the trial starts' : ' in addition to the subscription payment'}.`
        : duration
          ? ' No payment is required to start.'
          : '';
      if (policyText) policyText.textContent = trialCopy + paymentCopy;
      retryOptionsButton.classList.add('hidden');
    } catch (error) {
      registrationOptions = null;
      if (policyText)
        policyText.textContent =
          error instanceof Error
            ? error.message
            : 'Registration terms are unavailable. Please retry.';
      const trialLabel = document.getElementById('registration-trial-label');
      if (trialLabel) trialLabel.textContent = 'Trial terms unavailable';
      document.getElementById('registration-trial-badge')?.classList.add('hidden');
      retryOptionsButton.classList.remove('hidden');
    } finally {
      retryOptionsButton.disabled = false;
      updateOtpUi();
    }
  }
  retryOptionsButton?.addEventListener('click', () => void loadRegistrationOptions());
  emailVerification.setEmail(emailInput?.value || '');
  updateOtpUi();
  const otpUiTimer = window.setInterval(updateOtpUi, 1000);
  window.addEventListener('pagehide', () => window.clearInterval(otpUiTimer), { once: true });
  void loadRegistrationOptions();

  // Live Monospace Workspace URL Slug Preview
  if (businessNameInput && workspaceSlugPreview) {
    businessNameInput.addEventListener('input', () => {
      const val = businessNameInput.value.trim().toLowerCase();
      const slug = val.replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
      if (slug) {
        workspaceSlugPreview.textContent = `https://${slug}.markchat.co.ke`;
        workspaceSlugPreview.className = 'text-text font-medium transition-colors';
      } else {
        workspaceSlugPreview.textContent = 'https://your-workspace.markchat.co.ke';
        workspaceSlugPreview.className = 'text-text-muted/70 font-medium transition-colors';
      }
    });
  }

  // Password visibility toggle with accessible aria state
  const eyeOpenSvg = `
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
  `;
  const eyeClosedSvg = `
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21" />
  `;

  if (toggleBtn && passwordInput) {
    toggleBtn.addEventListener('click', () => {
      const isPassword = passwordInput.type === 'password';
      passwordInput.type = isPassword ? 'text' : 'password';
      toggleBtn.setAttribute('aria-pressed', isPassword ? 'true' : 'false');
      toggleBtn.setAttribute('aria-label', isPassword ? 'Hide password' : 'Show password');
      const eyeIcon = document.getElementById('eye-icon-reg');
      if (eyeIcon) eyeIcon.innerHTML = isPassword ? eyeClosedSvg : eyeOpenSvg;
    });
  }

  // NIST SP 800-63B Entropy Evaluation
  const commonPasswords = [
    'password',
    'password123',
    '1234567890',
    'qwertyuiop',
    'admin12345',
    'markchat123',
  ];

  function evaluatePasswordEntropy(password: string, email: string): 'weak' | 'fair' | 'strong' {
    if (!password || password.length < 8) return 'weak';
    const lower = password.toLowerCase();
    if (commonPasswords.includes(lower)) return 'weak';

    if (email) {
      const localPart = email.split('@')[0]?.toLowerCase();
      if (localPart && localPart.length >= 3 && lower.includes(localPart)) {
        return 'weak';
      }
    }

    let pools = 0;
    if (/[a-z]/.test(password)) pools++;
    if (/[A-Z]/.test(password)) pools++;
    if (/\d/.test(password)) pools++;
    if (/[^a-zA-Z0-9]/.test(password)) pools++;

    if (password.length >= 14 || (password.length >= 10 && pools >= 3)) {
      return 'strong';
    }
    if (password.length >= 8 && pools >= 2) {
      return 'fair';
    }
    return 'weak';
  }

  function updateStrengthUI(strength: 'weak' | 'fair' | 'strong') {
    if (!strengthContainer || !strengthLabel || !strengthBar1 || !strengthBar2 || !strengthBar3)
      return;
    strengthContainer.classList.remove('hidden');

    if (strength === 'strong') {
      strengthLabel.textContent = 'Strong';
      strengthLabel.className = 'font-semibold text-success';
      strengthBar1.className = 'h-full rounded-full bg-success';
      strengthBar2.className = 'h-full rounded-full bg-success';
      strengthBar3.className = 'h-full rounded-full bg-success';
    } else if (strength === 'fair') {
      strengthLabel.textContent = 'Fair';
      strengthLabel.className = 'font-semibold text-warning';
      strengthBar1.className = 'h-full rounded-full bg-warning';
      strengthBar2.className = 'h-full rounded-full bg-warning';
      strengthBar3.className = 'h-full rounded-full bg-border';
    } else {
      strengthLabel.textContent = 'Weak';
      strengthLabel.className = 'font-semibold text-error';
      strengthBar1.className = 'h-full rounded-full bg-error';
      strengthBar2.className = 'h-full rounded-full bg-border';
      strengthBar3.className = 'h-full rounded-full bg-border';
    }
  }

  // Validation rules
  const validationRules: Record<string, (value: string) => string | null> = {
    businessName: (value) => {
      if (!value.trim()) return 'Organization or business name is required';
      if (value.trim().length < 2) return 'Business name must be at least 2 characters';
      return null;
    },
    fullName: (value) => {
      if (!value.trim()) return 'Administrator full name is required';
      if (value.trim().length < 2) return 'Name must be at least 2 characters';
      return null;
    },
    registerEmail: (value) => {
      if (!value.trim()) return 'Email address is required';
      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      if (!emailRegex.test(value)) return 'Please enter a valid email address';
      return null;
    },
    registerPassword: (value) => {
      if (!value) return 'Password is required';
      const passwordError = registrationPasswordError(value);
      if (passwordError) return passwordError;
      const email = (document.getElementById('registerEmail') as HTMLInputElement)?.value;
      const strength = evaluatePasswordEntropy(value, email);
      updateStrengthUI(strength);
      if (strength === 'weak') {
        return 'Password is too common or easily guessed. Choose a more secure password.';
      }
      return null;
    },
    confirmPassword: (value) => {
      if (!value) return 'Please confirm your password';
      const original = passwordInput?.value;
      if (original && value !== original) return 'Passwords do not match';
      return null;
    },
  };

  function validateCheckbox(): string | null {
    const checkbox = document.getElementById('agreeTerms') as HTMLInputElement;
    if (!checkbox?.checked) {
      return 'You must agree to the Terms of Service and Privacy Policy to proceed';
    }
    return null;
  }

  function showError(fieldName: string, message: string | null) {
    const errorEl = document.querySelector(`#register-form [data-error="${fieldName}"]`);
    const inputEl = document.getElementById(fieldName) as HTMLInputElement | null;
    if (errorEl) {
      if (message) {
        errorEl.textContent = message;
        errorEl.classList.remove('hidden');
        if (inputEl) {
          inputEl.classList.add('border-error', 'focus:border-error', 'focus:ring-error/20');
          inputEl.setAttribute('aria-invalid', 'true');
        }
      } else {
        errorEl.classList.add('hidden');
        if (inputEl) {
          inputEl.classList.remove('border-error', 'focus:border-error', 'focus:ring-error/20');
          inputEl.removeAttribute('aria-invalid');
        }
      }
    }
  }

  function validateField(fieldName: string, force: boolean = false): boolean {
    if (!force && !touchedFields.has(fieldName)) return true;

    if (fieldName === 'agreeTerms') {
      const error = validateCheckbox();
      showError('agreeTerms', error);
      return !error;
    }
    const input = document.getElementById(fieldName) as HTMLInputElement | null;
    if (!input || !validationRules[fieldName]) return true;
    const error = validationRules[fieldName](input.value);
    showError(fieldName, error);
    return !error;
  }

  function validateStep1(): boolean {
    const step1Fields = ['businessName', 'fullName', 'registerEmail'];
    let valid = true;
    for (const f of step1Fields) {
      touchedFields.add(f);
      if (!validateField(f, true)) valid = false;
    }
    emailVerification.setEmail(emailInput.value);
    if (!emailVerification.token) {
      showOtpError('Verify your email with the six-digit code before continuing.');
      valid = false;
    }
    return valid;
  }

  function validateStep2(): boolean {
    let valid = true;
    touchedFields.add('registerPassword');
    touchedFields.add('confirmPassword');
    touchedFields.add('agreeTerms');
    if (!validateField('registerPassword', true)) valid = false;
    if (!validateField('confirmPassword', true)) valid = false;
    if (!validateField('agreeTerms', true)) valid = false;
    return valid;
  }

  // =====================================================================
  // STEP TRANSITION ENGINE
  // =====================================================================
  let currentStep = 1;

  function goToStep(step: number) {
    if (submitting) return;
    if (step === 2) {
      if (!validateStep1()) {
        const firstError = step1Container?.querySelector('[aria-invalid="true"]') as HTMLElement;
        firstError?.focus();
        return;
      }
      currentStep = 2;
      step1Container?.classList.add('hidden');
      step2Container?.classList.remove('hidden');

      // Update indicators
      if (progressBar) progressBar.style.width = '100%';
      if (mobileStepLabel) mobileStepLabel.textContent = 'Step 2 of 2: Security & plan';

      if (step1Badge) {
        step1Badge.className =
          'w-6 h-6 rounded-full bg-success text-white flex items-center justify-center text-xs font-bold shadow-xs';
        step1Badge.innerHTML =
          '<svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>';
      }
      if (step2Badge) {
        step2Badge.className =
          'w-6 h-6 rounded-full bg-primary text-white flex items-center justify-center text-xs font-bold shadow-xs';
      }
      if (step2Indicator) {
        step2Indicator.className =
          'flex items-center gap-2 text-xs font-semibold text-primary transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary rounded px-1.5 py-0.5 cursor-pointer';
      }

      passwordInput?.focus();
    } else {
      currentStep = 1;
      step2Container?.classList.add('hidden');
      step1Container?.classList.remove('hidden');

      // Update indicators
      if (progressBar) progressBar.style.width = '50%';
      if (mobileStepLabel) mobileStepLabel.textContent = 'Step 1 of 2: Organization details';

      if (step1Badge) {
        step1Badge.className =
          'w-6 h-6 rounded-full bg-primary text-white flex items-center justify-center text-xs font-bold shadow-xs';
        step1Badge.textContent = '1';
      }
      if (step2Badge) {
        step2Badge.className =
          'w-6 h-6 rounded-full bg-surface border border-border text-text-muted flex items-center justify-center text-xs font-bold';
        step2Badge.textContent = '2';
      }
      if (step2Indicator) {
        step2Indicator.className =
          'flex items-center gap-2 text-xs font-medium text-text-muted transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary rounded px-1.5 py-0.5 cursor-pointer';
      }
    }
  }

  // Event Listeners for Step Controls
  btnContinueStep1?.addEventListener('click', () => goToStep(2));
  btnBackStep2?.addEventListener('click', () => goToStep(1));
  btnBackHeader?.addEventListener('click', () => goToStep(1));

  step1Indicator?.addEventListener('click', () => goToStep(1));
  step2Indicator?.addEventListener('click', () => {
    if (currentStep === 1) goToStep(2);
  });

  // Real-time blur & input event bindings: mark touched only on blur
  const allFieldNames = [
    'businessName',
    'fullName',
    'registerEmail',
    'registerPassword',
    'confirmPassword',
  ];
  for (const fieldName of allFieldNames) {
    const input = document.getElementById(fieldName);
    input?.addEventListener('blur', () => {
      touchedFields.add(fieldName);
      validateField(fieldName);
    });
    input?.addEventListener('input', () => {
      const errorEl = document.querySelector(`#register-form [data-error="${fieldName}"]`);
      if (errorEl && !errorEl.classList.contains('hidden')) {
        validateField(fieldName);
      }
      if (fieldName === 'registerPassword') {
        const val = (input as HTMLInputElement).value;
        const email = (document.getElementById('registerEmail') as HTMLInputElement)?.value;
        if (val) {
          updateStrengthUI(evaluatePasswordEntropy(val, email));
        }
        if (confirmPasswordInput?.value) {
          validateField('confirmPassword');
        }
      }
    });
  }

  const agreeTermsCheckbox = document.getElementById('agreeTerms');
  agreeTermsCheckbox?.addEventListener('change', () => {
    touchedFields.add('agreeTerms');
    validateField('agreeTerms');
  });

  // =====================================================================
  // VERIFIED REGISTRATION, PAYMENT GATES & AUTHENTICATED HANDOFF
  // =====================================================================
  type RegistrationCredentials = { email: string; password: string };

  function setSubmitting(value: boolean) {
    submitting = value;
    form.setAttribute('aria-busy', String(value));
    for (const control of form.querySelectorAll<HTMLInputElement | HTMLButtonElement>(
      'input, button'
    )) {
      control.disabled = value;
    }
    for (const indicator of [step1Indicator, step2Indicator]) {
      (indicator as HTMLButtonElement | null)?.toggleAttribute('disabled', value);
    }
    buttonText?.classList.toggle('hidden', value);
    buttonLoading?.classList.toggle('hidden', !value);
    buttonLoading?.classList.toggle('inline-flex', value);
    if (value) retryPaymentButton?.classList.add('hidden');
    if (!value) updateOtpUi();
  }

  if (form) {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (submitting) return;
      formStatus?.classList.add('hidden');
      formSuccess?.classList.add('hidden');
      formError?.classList.add('hidden');
      const gotcha = (form.querySelector('input[name="_gotcha"]') as HTMLInputElement)?.value;
      if (gotcha) return;
      if (!validateStep1()) {
        goToStep(1);
        return;
      }
      if (!validateStep2()) {
        const firstError = step2Container?.querySelector('[aria-invalid="true"]') as HTMLElement;
        firstError?.focus();
        return;
      }
      if (!registrationOptions) {
        showFormError(
          'Registration terms are unavailable. Retry loading them before creating your workspace.'
        );
        return;
      }
      const interval =
        (document.getElementById('billingInterval') as HTMLInputElement).value === 'annual'
          ? 'annual'
          : 'monthly';
      if (interval === 'annual' && registrationOptions.trialHours === 0) {
        showFormError(
          'Annual checkout is not available. Select monthly billing or contact sales before registering.'
        );
        return;
      }
      const email = emailInput.value.trim().toLowerCase();
      const password = passwordInput.value;
      const planId = planInput.value || 'growth';
      const redirectTarget =
        '/billing?plan=' + encodeURIComponent(planId) + '&interval=' + interval;
      const payload = {
        businessName: businessNameInput.value.trim(),
        fullName: (document.getElementById('fullName') as HTMLInputElement).value.trim(),
        email,
        phone: (document.getElementById('registerPhone') as HTMLInputElement).value.trim(),
        password,
        planId,
        otpVerificationToken: emailVerification.token,
      };
      setSubmitting(true);
      try {
        let idempotencyKey = sessionStorage.getItem('markchat_reg_idempotency_key');
        if (!idempotencyKey) {
          idempotencyKey = 'reg_' + crypto.randomUUID();
          sessionStorage.setItem('markchat_reg_idempotency_key', idempotencyKey);
        }
        if (loadingStatus) loadingStatus.textContent = 'Creating your verified workspace...';
        const data = await registrationRequest(apiUrl, '/api/v1/registration', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Idempotency-Key': idempotencyKey },
          body: JSON.stringify(payload),
        });
        if (
          typeof data.registrationId !== 'string' ||
          !data.registrationId ||
          typeof data.verificationRequired !== 'boolean' ||
          !Number.isSafeInteger(data.trialHours)
        ) {
          throw new RegistrationError(
            'The registration response could not be confirmed. Contact support before retrying or making a payment.'
          );
        }
        currentRegistration = {
          registrationId: data.registrationId,
          sessionToken: typeof data.sessionToken === 'string' ? data.sessionToken : '',
          verificationToken:
            typeof data.verificationToken === 'string' ? data.verificationToken : undefined,
          redirectTarget,
          createdAt: Date.now(),
        };
        if (currentRegistration.sessionToken) {
          saveRegistrationResume(currentRegistration);
          resumeButton?.classList.remove('hidden');
        }
        await continueRegistration(currentRegistration, { email, password });
      } catch (error) {
        if (
          error instanceof RegistrationError &&
          /^OTP_(?:VERIFICATION_REQUIRED|GRANT_ALREADY_USED|INVALID|EXPIRED)$/.test(error.code)
        ) {
          emailVerification.invalidateProof();
          setSubmitting(false);
          goToStep(1);
        }
        const retry =
          error instanceof RegistrationError && error.status === 429
            ? ` Please wait ${error.retryAfterSeconds || 60} seconds before trying again.`
            : '';
        showFormError(
          (error instanceof Error
            ? error.message
            : 'Unable to connect to registration. Please try again.') + retry
        );
      }
    });
  }

  async function beginPayment(
    registration: RegistrationResume,
    purpose: RegistrationPaymentPurpose,
    allowRetry = false
  ) {
    if (!registration.sessionToken) {
      throw new RegistrationError(
        'A secure workspace session could not be prepared. Contact support before making a payment.'
      );
    }
    if (
      purpose === 'subscription' &&
      new URLSearchParams(registration.redirectTarget.split('?')[1]).get('interval') === 'annual'
    ) {
      throw new RegistrationError(
        'Annual checkout is not enabled. Contact sales before continuing this registration.'
      );
    }
    if (loadingStatus)
      loadingStatus.textContent =
        purpose === 'account_verification'
          ? 'Preparing account confirmation...'
          : 'Preparing your subscription checkout...';
    const progress = await prepareRegistrationPayment(apiUrl, registration, purpose, {
      allowRetry,
    });
    if (progress.kind === 'checkout') {
      window.location.assign(progress.checkout.authorizationUrl);
      return;
    }
    if (progress.kind === 'retry' || progress.kind === 'connection_retry') {
      showFormError(
        progress.kind === 'retry'
          ? 'The provider confirmed that the earlier payment failed or was abandoned. You can retry that payment to continue setup.'
          : 'No new payment attempt was recorded. Retry the connection to continue your saved workspace setup.'
      );
      retryPaymentButton.textContent =
        progress.kind === 'retry' ? 'Retry payment' : 'Retry connection';
      retryPaymentButton.classList.remove('hidden');
      return;
    }
    showFormError(
      progress.kind === 'waiting'
        ? progress.message
        : 'Payment confirmation is unavailable. Check again or contact support before making another payment.'
    );
  }

  async function continueRegistration(
    registration: RegistrationResume,
    credentials?: RegistrationCredentials
  ) {
    const maxAttempts = 30;
    const deadline = Date.now() + 65000;
    for (let attempt = 0; attempt < maxAttempts && Date.now() < deadline; attempt++) {
      if (loadingStatus)
        loadingStatus.textContent = `Preparing your workspace (${attempt + 1}/${maxAttempts})...`;
      let statusData;
      try {
        statusData = await registrationRequest(
          apiUrl,
          `/api/v1/registration/${encodeURIComponent(registration.registrationId)}`
        );
      } catch (error) {
        if (error instanceof RegistrationError && error.status >= 400 && error.status < 500)
          throw error;
        await new Promise((resolve) => setTimeout(resolve, 2000));
        continue;
      }
      if (statusData.status === 'completed') {
        try {
          await completeRegistration(registration, credentials);
          return;
        } catch (error) {
          // Provisioning may finish before the authenticated handoff becomes ready.
          if (!(error instanceof RegistrationError && error.status === 409)) throw error;
        }
      } else if (statusData.status === 'failed') {
        throw new RegistrationError(
          'Workspace setup needs support. Your registration was saved; do not pay again.'
        );
      } else {
        const purpose = registrationPaymentRequired(statusData.paymentRequirements);
        if (purpose) {
          await beginPayment(registration, purpose);
          return;
        }
      }
      await new Promise((resolve) => setTimeout(resolve, 2000));
    }
    throw new RegistrationError(
      'Workspace setup is still processing. Use “Continue workspace setup” to check again; do not register or pay twice.'
    );
  }

  async function completeRegistration(
    registration: RegistrationResume,
    credentials?: RegistrationCredentials
  ) {
    if (loadingStatus) loadingStatus.textContent = 'Signing you in...';
    const handoff = await obtainRegistrationSession(apiUrl, registration, credentials);
    if (!handoff) {
      const signIn = document.getElementById('registration-sign-in') as HTMLAnchorElement;
      if (signIn) {
        signIn.href = '/login?redirect=' + encodeURIComponent(registration.redirectTarget);
        signIn.classList.remove('hidden');
      }
      throw new RegistrationError(
        'Your workspace is ready, but the secure setup session expired. Sign in to continue.'
      );
    }
    persistCustomerSession(handoff.token);
    clearRegistrationResume();
    clearPendingRegistrationPayment();
    try {
      sessionStorage.removeItem('markchat_reg_idempotency_key');
    } catch {
      /* Session exchange is already complete. */
    }
    passwordInput.value = '';
    confirmPasswordInput.value = '';
    if (credentials) credentials.password = '';
    formStatus?.classList.remove('hidden');
    formSuccess?.classList.remove('hidden');
    const destination = customerDestination(handoff.ssoUrl, registration.redirectTarget);
    window.location.assign(destination);
  }

  resumeButton?.addEventListener('click', async () => {
    if (submitting) return;
    const registration = currentRegistration || readRegistrationResume();
    if (!registration) {
      showFormError(
        'Your setup session expired. Sign in or contact support to recover this workspace.'
      );
      return;
    }
    setSubmitting(true);
    try {
      await continueRegistration(registration);
    } catch (error) {
      showFormError(
        error instanceof Error
          ? error.message
          : 'Workspace setup could not be resumed. Please try again.'
      );
    }
  });

  retryPaymentButton?.addEventListener('click', async () => {
    if (submitting) return;
    const registration = currentRegistration || readRegistrationResume();
    if (!registration) {
      showFormError('Your setup session expired. Contact support before making another payment.');
      return;
    }
    setSubmitting(true);
    try {
      const statusData = await registrationRequest(
        apiUrl,
        `/api/v1/registration/${encodeURIComponent(registration.registrationId)}`
      );
      if (statusData.status === 'failed')
        throw new RegistrationError('Workspace setup needs support. Do not make another payment.');
      const purpose = registrationPaymentRequired(statusData.paymentRequirements);
      if (!purpose || statusData.status === 'completed') await continueRegistration(registration);
      else await beginPayment(registration, purpose, true);
    } catch (error) {
      showFormError(
        error instanceof Error
          ? error.message
          : 'The payment could not be confirmed. Check again before retrying.'
      );
    }
  });

  function showFormError(message: string) {
    formStatus?.classList.remove('hidden');
    formError?.classList.remove('hidden');
    const errText = document.getElementById('register-error-text');
    if (errText) errText.textContent = message;
    resetButtonState();
  }

  function resetButtonState() {
    setSubmitting(false);
  }
</script>
