---
import { existsSync } from 'node:fs';
import path from 'node:path';
import type { HeroMediaPage, HeroMediaSettings } from '@/lib/types';
import { normalizeHeroMedia } from '@/lib/hero-media';
import MCConceptualPreview from './MCConceptualPreview.astro';

interface Props {
  page: HeroMediaPage;
  settings?: Partial<HeroMediaSettings> | null;
  presentation?: 'framed' | 'backdrop';
  class?: string;
  focalPoint?: 'center' | 'right';
}

const {
  page,
  settings,
  presentation = 'framed',
  class: className = '',
  focalPoint = 'center',
} = Astro.props;
const media = normalizeHeroMedia(page, settings, import.meta.env.PUBLIC_CMS_MEDIA_HOST || '');
const isBundled = (url: string) =>
  url.startsWith('/') ? existsSync(path.join(process.cwd(), 'public', url.slice(1))) : true;
const desktop =
  media.heroBackgroundImageUrl && isBundled(media.heroBackgroundImageUrl)
    ? media.heroBackgroundImageUrl
    : '';
const mobile =
  media.heroBackgroundMobileImageUrl && isBundled(media.heroBackgroundMobileImageUrl)
    ? media.heroBackgroundMobileImageUrl
    : '';
const image = media.heroMediaMode === 'layered-preview' ? '' : desktop || mobile;
const scrims = {
  subtle: 'bg-stone-100/55 dark:bg-neutral-900/60',
  medium: 'bg-stone-100/88 dark:bg-neutral-900/85',
  strong: 'bg-stone-100/95 dark:bg-neutral-900/95',
};
const framed = presentation === 'framed';
const focalClass = focalPoint === 'right' ? 'object-right' : 'object-center';
const productLayouts = {
  homepage: ['inbox', 'mpesa', 'markcopilot'],
  features: ['inbox', 'automation-routing', 'analytics-webhooks'],
  markcopilot: ['markcopilot', 'inbox', 'help-center'],
  integrations: ['inbox', 'mpesa', 'automation-routing'],
  solutions: ['inbox', 'contact-crm', 'help-center'],
  about: ['inbox', 'markcopilot', 'mpesa'],
  careers: ['inbox', 'markcopilot', 'mpesa'],
} as const;
const previewKinds = productLayouts[page];
---

{
  page !== 'careers' && !image && framed && (
    <figure
      data-mc-layered-hero
      data-hero-media-page={page}
      class:list={[
        'overflow-hidden rounded-xl border border-border bg-surface p-3 sm:p-4',
        className,
      ]}
    >
      <div class="grid gap-3 lg:grid-cols-[1.1fr_0.9fr]">
        <MCConceptualPreview kind={previewKinds[0]} class="min-h-52" />
        <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-1">
          <MCConceptualPreview kind={previewKinds[1]} />
          <MCConceptualPreview kind={previewKinds[2]} />
        </div>
      </div>
      <figcaption class="mt-3 text-right text-xs text-text-muted">
        Conceptual product preview
      </figcaption>
    </figure>
  )
}

{
  page !== 'careers' && image && (
    <figure
      data-mc-responsive-hero
      data-hero-media-page={page}
      data-hero-media-mode={media.heroMediaMode}
      class:list={[
        'relative overflow-hidden',
        framed ? 'rounded-2xl border border-border bg-surface' : 'absolute inset-0',
        className,
      ]}
    >
      <picture>
        {mobile && <source media="(max-width: 767px)" srcset={mobile} />}
        <img
          src={image}
          alt={framed ? media.heroBackgroundAlt : ''}
          width="1440"
          height="900"
          decoding="async"
          loading={page === 'homepage' ? 'eager' : 'lazy'}
          class:list={[
            'block h-full w-full object-cover',
            framed ? 'aspect-[4/5] sm:aspect-[16/10] lg:aspect-[16/9]' : 'absolute inset-0',
            focalClass,
          ]}
          data-editorial-picture
        />
      </picture>
      {(presentation === 'backdrop' || media.heroMediaMode === 'editorial-backdrop') && (
        <div
          class:list={['absolute inset-0', scrims[media.heroScrimStrength]]}
          aria-hidden="true"
        />
      )}
      {framed && (
        <figcaption class="relative border-t border-border bg-background px-4 py-2 text-xs text-text-muted">
          Editorial illustration · not a screenshot of MarkChat software
        </figcaption>
      )}
    </figure>
  )
}

{
  page === 'careers' && (
    <figure
      data-careers-hero
      data-hero-media-page="careers"
      class:list={[
        'overflow-hidden rounded-2xl border border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900',
        className,
      ]}
      style={`--hero-x:${media.heroFocalX}%;--hero-y:${media.heroFocalY}%;--hero-mobile-x:${media.heroMobileFocalX}%;--hero-mobile-y:${media.heroMobileFocalY}%`}
    >
      <div class="relative aspect-[16/10] w-full overflow-hidden">
        <picture>
          <source media="(max-width: 767px)" srcset={mobile || undefined} />
          <img
            src={image || undefined}
            alt={media.heroBackgroundAlt}
            width="1600"
            height="1066"
            decoding="async"
            loading="eager"
            fetchpriority="high"
            data-careers-picture
            class:list={[
              'careers-hero-picture absolute inset-0 block h-full w-full object-cover',
              !image && 'invisible',
            ]}
          />
        </picture>
        <div
          data-careers-picture-fallback
          class:list={[
            'absolute inset-0 flex flex-col items-center justify-center gap-2 bg-slate-100 px-8 text-center dark:bg-slate-900',
            Boolean(image) && 'hidden',
          ]}
        >
          <span class="text-lg font-semibold text-slate-900 dark:text-white">
            Careers at MarkChat
          </span>
          <span class="text-sm text-slate-600 dark:text-slate-300">
            Explore our open roles and join the talent pool.
          </span>
        </div>
      </div>
    </figure>
  )
}

<style>
  .careers-hero-picture {
    object-position: var(--hero-x, 62%) var(--hero-y, 50%);
  }
  @media (max-width: 767px) {
    .careers-hero-picture {
      object-position: var(--hero-mobile-x, 65%) var(--hero-mobile-y, 50%);
    }
  }
</style>

<script>
  import { normalizeHeroMedia } from '@/lib/hero-media';

  function initCareersHero() {
    document.querySelectorAll<HTMLElement>('[data-careers-hero]').forEach((frame) => {
      if (frame.dataset.bound) return;
      frame.dataset.bound = 'true';
      const picture = frame.querySelector<HTMLImageElement>('[data-careers-picture]');
      const fallback = frame.querySelector<HTMLElement>('[data-careers-picture-fallback]');
      const source = frame.querySelector<HTMLSourceElement>('source');
      if (!picture || !fallback || !source) return;
      const failed = () => {
        picture.classList.add('invisible');
        fallback.classList.remove('hidden');
      };
      picture.addEventListener('error', failed);
      picture.addEventListener('load', () => {
        picture.classList.remove('invisible');
        fallback.classList.add('hidden');
      });
      if (picture.complete && !picture.naturalWidth) failed();
      // Keep the fixed frame while loading a durable CMS override. No candidate
      // information or admin credentials are involved in this public request.
      void fetch('/api/careers/hero', { credentials: 'omit', signal: AbortSignal.timeout(5000) })
        .then(async (response) => {
          if (!response.ok || !response.headers.get('content-type')?.includes('application/json'))
            return;
          const data = await response.json();
          if (!data || typeof data !== 'object' || Array.isArray(data)) return;
          const settings = normalizeHeroMedia(
            'careers',
            data,
            import.meta.env.PUBLIC_CMS_MEDIA_HOST || ''
          );
          const url =
            settings.heroMediaMode === 'layered-preview'
              ? ''
              : settings.heroBackgroundImageUrl || settings.heroBackgroundMobileImageUrl;
          for (const [name, value] of [
            ['x', settings.heroFocalX],
            ['y', settings.heroFocalY],
            ['mobile-x', settings.heroMobileFocalX],
            ['mobile-y', settings.heroMobileFocalY],
          ] as const)
            frame.style.setProperty('--hero-' + name, String(value) + '%');
          picture.alt = settings.heroBackgroundAlt;
          if (!url) {
            source.removeAttribute('srcset');
            picture.removeAttribute('src');
            failed();
            return;
          }
          if (settings.heroBackgroundMobileImageUrl)
            source.srcset = settings.heroBackgroundMobileImageUrl;
          else source.removeAttribute('srcset');
          if (picture.getAttribute('src') !== url) picture.src = url;
          if (picture.complete && picture.naturalWidth) {
            picture.classList.remove('invisible');
            fallback.classList.add('hidden');
          }
        })
        .catch(() => {
          /* Bundled image stays visible if public settings are unavailable. */
        });
    });
  }
  function initEditorialHeroMedia() {
    document.querySelectorAll<HTMLImageElement>('[data-editorial-picture]').forEach((image) => {
      if (image.dataset.errorBound) return;
      image.dataset.errorBound = 'true';
      const fail = () =>
        image.closest<HTMLElement>('[data-mc-responsive-hero]')?.classList.add('hidden');
      image.addEventListener('error', fail);
      if (image.complete && !image.naturalWidth) fail();
    });
  }
  initEditorialHeroMedia();
  initCareersHero();
  document.addEventListener('astro:page-load', initEditorialHeroMedia);
  document.addEventListener('astro:page-load', initCareersHero);
</script>
