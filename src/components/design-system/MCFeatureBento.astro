---
import MCFeatureCard from './MCFeatureCard.astro';
import type { CmsProductMediaOverride } from '@/data/product-assets';

interface Feature {
  id: string;
  title: string;
  description: string;
  icon: string;
  href?: string;
  illustration?: string;
  cmsMedia?: CmsProductMediaOverride | null;
}
interface Props {
  features: Feature[];
}
const { features } = Astro.props;
const primary = features[0];
const secondary = features.slice(1, 3);
const supporting = features.slice(3);
---

<div class="space-y-4" data-mc-feature-bento>
  <div class="grid gap-4 lg:grid-cols-[1.1fr_0.9fr]">
    {primary && <MCFeatureCard feature={primary} aspect="primary" />}
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-1">
      {secondary.map((feature) => <MCFeatureCard feature={feature} aspect="primary" />)}
    </div>
  </div>
  <div class="grid gap-4 md:grid-cols-2">
    {supporting.map((feature) => <MCFeatureCard feature={feature} aspect="supporting" />)}
  </div>
</div>
