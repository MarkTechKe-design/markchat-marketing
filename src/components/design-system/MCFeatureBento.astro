---
import MCCard from './MCCard.astro';
import MCCapabilityMedia from './MCCapabilityMedia.astro';
import type { CapabilityId } from './MCCapabilityPreview.astro';

interface Feature {
  id: CapabilityId;
  title: string;
  description: string;
  href?: string;
  /** CMS or verified synthetic Core capture, if available. */
  mediaUrl?: string | null;
  mediaAlt?: string;
  mediaSource?: 'cms' | 'captured' | 'fallback';
}

interface Props {
  features: Feature[];
}

const { features } = Astro.props;
const primary = features.find((feature) => feature.id === 'unified-inbox');
const secondary = features.filter(
  (feature) => feature.id === 'mpesa-stk' || feature.id === 'markcopilot'
);
const supporting = features.filter(
  (feature) => !['unified-inbox', 'mpesa-stk', 'markcopilot'].includes(feature.id)
);
---

<div class="space-y-4" data-mc-feature-bento>
  <div class="grid gap-4 lg:grid-cols-[1.1fr_0.9fr]">
    {
      primary && (
        <MCCard class="group min-w-0 overflow-hidden" padded={false}>
          <div class="p-4 sm:p-6">
            <p class="text-xs font-bold uppercase tracking-widest text-primary">Core workspace</p>
            <h3 class="mt-3 text-2xl font-bold tracking-tight text-text sm:text-3xl">
              {primary.title}
            </h3>
            <p class="mt-3 max-w-md text-sm leading-relaxed text-text-muted">
              {primary.description}
            </p>
          </div>
          <div class="px-3 sm:px-5">
            <MCCapabilityMedia
              id={primary.id}
              src={primary.mediaUrl}
              alt={primary.mediaAlt}
              source={primary.mediaSource}
              size="large"
            />
          </div>
          <div class="p-4 sm:p-6">
            {primary.href && (
              <a href={primary.href} class="inline-flex text-sm font-bold text-primary hover:underline">
                Explore the workspace <span aria-hidden="true"> →</span>
              </a>
            )}
          </div>
        </MCCard>
      )
    }
    <div class="grid min-w-0 gap-4 sm:grid-cols-2 lg:grid-cols-1">
      {
        secondary.map((feature) => (
          <MCCard class="group min-w-0 overflow-hidden" padded={false}>
            <div class="p-3 sm:p-4">
              <MCCapabilityMedia
                id={feature.id}
                src={feature.mediaUrl}
                alt={feature.mediaAlt}
                source={feature.mediaSource}
                size="large"
              />
            </div>
            <div class="px-4 pb-5">
              <h3 class="text-lg font-bold text-text">{feature.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-text-muted">{feature.description}</p>
              {feature.href && (
                <a href={feature.href} class="mt-3 inline-flex text-sm font-semibold text-primary hover:underline">
                  Explore feature <span aria-hidden="true"> →</span>
                </a>
              )}
            </div>
          </MCCard>
        ))
      }
    </div>
  </div>
  <div class="grid gap-4 sm:grid-cols-2">
    {
      supporting.map((feature) => (
        <MCCard class="group min-w-0 overflow-hidden" padded={false}>
          <div class="p-3 sm:p-4">
            <MCCapabilityMedia
              id={feature.id}
              src={feature.mediaUrl}
              alt={feature.mediaAlt}
              source={feature.mediaSource}
            />
          </div>
          <div class="px-4 pb-5">
            <h3 class="text-base font-bold text-text">{feature.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-text-muted">{feature.description}</p>
            {feature.href && (
              <a href={feature.href} class="mt-3 inline-flex text-sm font-semibold text-primary hover:underline">
                Explore feature <span aria-hidden="true"> →</span>
              </a>
            )}
          </div>
        </MCCard>
      ))
    }
  </div>
</div>
