---
/**
 * Public-facing MarkChat™ product assistant.
 * No client secrets, no untrusted innerHTML, and no fabricated delivery confirmations.
 */
import { Icon } from 'astro-icon/components';
---

<div id="markcopilot-root" class="pointer-events-none fixed inset-0 z-[60] font-sans">
  <section
    id="markcopilot-panel"
    role="dialog"
    aria-modal="true"
    aria-labelledby="markcopilot-title"
    aria-describedby="markcopilot-description"
    aria-hidden="true"
    tabindex="-1"
    class="pointer-events-auto fixed inset-x-3 bottom-[calc(5rem+env(safe-area-inset-bottom))] hidden max-h-[75dvh] flex-col overflow-hidden rounded-2xl border border-border bg-surface/95 text-text shadow-[0_20px_60px_-24px_rgba(15,23,42,0.45)] backdrop-blur-md transition-[opacity,transform] duration-200 sm:inset-x-auto sm:bottom-24 sm:right-6 sm:h-[600px] sm:w-[400px] sm:max-h-[min(600px,calc(100dvh-7rem))]"
  >
    <div class="flex shrink-0 items-center justify-between border-b border-border bg-surface-elevated px-4 py-3">
      <div class="flex min-w-0 items-center gap-3">
        <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl border border-[#3B82F6]/30 bg-[#2563EB]/10 text-[#1D4ED8] dark:bg-[#3B82F6]/20 dark:text-[#93C5FD]">
          <Icon name="lucide:messages-square" class="h-5 w-5" />
        </span>
        <div class="min-w-0">
          <h2 id="markcopilot-title" class="truncate text-sm font-bold text-text">MarkChat™ Assistant</h2>
          <p id="markcopilot-description" class="text-[11px] text-text-muted">
            Ask about plans, features and M-Pesa integrations
          </p>
          <span
            id="markcopilot-mode"
            aria-live="polite"
            class="mt-1 inline-flex items-center gap-1.5 rounded-full border border-border bg-surface px-2 py-0.5 text-[10px] font-semibold text-text-muted"
          >
            Product Guide
          </span>
        </div>
      </div>
      <button
        id="markcopilot-header-close"
        type="button"
        aria-label="Close MarkChat assistant"
        class="rounded-lg p-2 text-text-muted transition-colors hover:bg-surface-hover hover:text-text focus-visible:outline-2 focus-visible:outline-primary"
      >
        <Icon name="lucide:x" class="h-5 w-5" />
      </button>
    </div>

    <div
      id="markcopilot-messages"
      aria-live="polite"
      aria-relevant="additions text"
      class="min-h-0 flex-1 space-y-3 overflow-y-auto overscroll-contain bg-background/40 px-4 py-4 text-sm"
    >
      <div class="max-w-[90%] rounded-2xl rounded-tl-sm border border-border bg-surface px-4 py-3 text-text shadow-sm">
        Habari! I can help you explore MarkChat plans, supported channels and configured M-Pesa
        workflows. I'll clearly distinguish live information from general product guidance.
      </div>
      <div class="flex flex-wrap gap-2" id="markcopilot-quick-actions">
        {
          [
            'How does M-Pesa STK checkout work?',
            'Compare KES Pricing Plans',
            'Pochi la Biashara & Paybill Sync',
            'Book a Live Demo',
          ].map((prompt) => (
            <button
              type="button"
              data-mc-prompt={prompt}
              class="rounded-full border border-[#3B82F6]/20 bg-[#2563EB]/10 px-3 py-1.5 text-left text-xs font-medium text-[#1D4ED8] transition-colors hover:bg-[#2563EB]/15 focus-visible:outline-2 focus-visible:outline-primary dark:bg-[#3B82F6]/15 dark:text-[#93C5FD]"
            >
              {prompt}
            </button>
          ))
        }
      </div>
    </div>

    <p id="markcopilot-error" role="alert" class="hidden px-4 py-2 text-xs text-rose-700 dark:text-rose-300">
      Unable to reach the assistant. You can contact hello@markchat.co.ke.
    </p>

    <form
      id="markcopilot-lead-form"
      class="hidden shrink-0 space-y-2 overflow-y-auto border-t border-border bg-surface p-4 text-xs"
      autocomplete="on"
    >
      <div class="flex items-center justify-between">
        <h3 class="font-semibold text-text">Request a tailored demo</h3>
        <button type="button" id="markcopilot-lead-dismiss" class="text-text-muted underline">Back to chat</button>
      </div>
      <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
        <label class="space-y-1">
          <span class="text-text-muted">Full name *</span>
          <input name="name" required minlength="2" maxlength="100" autocomplete="name" class="w-full rounded-lg border border-border bg-background px-3 py-2 text-text" />
        </label>
        <label class="space-y-1">
          <span class="text-text-muted">Email *</span>
          <input name="email" required type="email" maxlength="254" autocomplete="email" class="w-full rounded-lg border border-border bg-background px-3 py-2 text-text" />
        </label>
        <label class="space-y-1">
          <span class="text-text-muted">Kenyan phone *</span>
          <input name="phone" required type="tel" inputmode="tel" maxlength="24" placeholder="+2547..." autocomplete="tel" class="w-full rounded-lg border border-border bg-background px-3 py-2 text-text" />
        </label>
        <label class="space-y-1">
          <span class="text-text-muted">Business</span>
          <input name="businessName" maxlength="100" autocomplete="organization" class="w-full rounded-lg border border-border bg-background px-3 py-2 text-text" />
        </label>
      </div>
      <label class="block space-y-1">
        <span class="text-text-muted">What can we help you with? *</span>
        <select name="interest" required class="w-full rounded-lg border border-border bg-background px-3 py-2 text-text">
          <option value="Product demonstration">Product demonstration</option>
          <option value="Core plans and pricing">Core plans and pricing</option>
          <option value="M-Pesa checkout setup">M-Pesa checkout setup</option>
          <option value="Messaging channels">Messaging channels</option>
          <option value="Separate SMS services">Separate SMS services</option>
        </select>
      </label>
      <label class="flex items-start gap-2 text-text-muted">
        <input name="consent" type="checkbox" required class="mt-0.5" />
        <span>I agree to be contacted about my inquiry. <a href="/privacy" class="underline" target="_blank" rel="noopener">Privacy policy</a>.</span>
      </label>
      <div class="hidden" aria-hidden="true">
        <label>Leave blank<input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
      </div>
      <input type="hidden" name="startedAt" id="markcopilot-form-started" />
      <p id="markcopilot-lead-feedback" role="status" aria-live="polite" class="hidden text-xs"></p>
      <button
        type="submit"
        id="markcopilot-lead-submit"
        class="w-full rounded-lg border border-[#1D4ED8]/20 bg-[#2563EB] px-4 py-2.5 font-semibold text-white transition-all hover:bg-[#1D4ED8] focus-visible:outline-2 focus-visible:outline-primary dark:bg-[#3B82F6] dark:hover:bg-[#2563EB]"
      >
        Send demo request
      </button>
      <p class="text-center text-[11px] text-text-muted">Prefer email? <a href="mailto:hello@markchat.co.ke" class="underline">hello@markchat.co.ke</a></p>
    </form>

    <form
      id="markcopilot-composer"
      class="flex shrink-0 items-center gap-2 border-t border-border bg-surface-elevated p-3"
    >
      <label for="markcopilot-input" class="sr-only">Ask a question about MarkChat</label>
      <input
        id="markcopilot-input"
        type="text"
        maxlength="600"
        autocomplete="off"
        placeholder="Ask about MarkChat…"
        class="min-w-0 flex-1 rounded-xl border border-border bg-background px-3 py-2.5 text-sm text-text placeholder:text-text-muted focus:outline-2 focus:outline-primary"
      />
      <button
        id="markcopilot-send-btn"
        type="submit"
        aria-label="Send message"
        class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-[#2563EB] text-white hover:bg-[#1D4ED8] disabled:opacity-50 dark:bg-[#3B82F6]"
      >
        <Icon name="lucide:send" class="h-4 w-4" />
      </button>
    </form>
  </section>
  <button
    id="markcopilot-launcher"
    type="button"
    aria-label="Open MarkChat assistant"
    aria-controls="markcopilot-panel"
    aria-expanded="false"
    class="pointer-events-auto fixed bottom-[calc(1rem+env(safe-area-inset-bottom))] right-4 flex h-14 w-14 items-center justify-center rounded-full border border-[#60A5FA]/30 bg-[#2563EB] text-white shadow-xl transition-all hover:-translate-y-0.5 hover:bg-[#1D4ED8] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary sm:bottom-6 sm:right-6"
  >
    <Icon name="lucide:message-square" class="h-6 w-6" />
  </button>
</div>

<script>
  function initializeMarkChatAssistant() {
    const panel = document.getElementById('markcopilot-panel');
    const launcher = document.getElementById('markcopilot-launcher');
    const close = document.getElementById('markcopilot-header-close');
    const composer = document.getElementById('markcopilot-composer') as HTMLFormElement | null;
    const messageInput = document.getElementById('markcopilot-input') as HTMLInputElement | null;
    const sendButton = document.getElementById('markcopilot-send-btn') as HTMLButtonElement | null;
    const list = document.getElementById('markcopilot-messages');
    const status = document.getElementById('markcopilot-mode');
    const error = document.getElementById('markcopilot-error');
    const leadForm = document.getElementById('markcopilot-lead-form') as HTMLFormElement | null;
    const leadDismiss = document.getElementById('markcopilot-lead-dismiss');
    const leadFeedback = document.getElementById('markcopilot-lead-feedback');
    const leadSubmit = document.getElementById('markcopilot-lead-submit') as HTMLButtonElement | null;
    const leadStart = document.getElementById('markcopilot-form-started') as HTMLInputElement | null;
    if (!panel || !launcher || !composer || !messageInput || !sendButton || !list || !leadForm) return;
    if (panel.dataset.bound === 'true') return;
    panel.dataset.bound = 'true';

    const history: Array<{ role: 'user' | 'assistant'; text: string }> = [];
    let previousFocus: HTMLElement | null = null;

    const setMode = (mode: 'live' | 'guide') => {
      if (status) status.textContent = mode === 'live' ? 'AI Assistant • Live' : 'Product Guide';
    };
    setMode('guide'); // Never claim live until the server confirms a live answer.

    function renderBubble(text: string, role: 'user' | 'assistant') {
      const bubble = document.createElement('div');
      bubble.className = role === 'user'
        ? 'ml-auto max-w-[90%] whitespace-pre-wrap break-words rounded-2xl rounded-tr-sm bg-[#2563EB] px-4 py-3 text-white'
        : 'max-w-[90%] whitespace-pre-wrap break-words rounded-2xl rounded-tl-sm border border-border bg-surface px-4 py-3 text-text shadow-sm';
      bubble.textContent = text;
      list?.appendChild(bubble);
      if (list) list.scrollTop = list.scrollHeight;
    }

    function setError(text: string | null) {
      if (!error) return;
      error.classList.toggle('hidden', !text);
      if (text) error.textContent = text;
    }

    function showLead() {
      if (leadStart) leadStart.value = String(Date.now());
      leadForm?.classList.remove('hidden');
      composer?.classList.add('hidden');
      if (list) list.scrollTop = list.scrollHeight;
      const first = leadForm?.querySelector<HTMLElement>('input[name="name"]');
      first?.focus();
    }
    function hideLead() {
      leadForm?.classList.add('hidden');
      composer?.classList.remove('hidden');
      messageInput?.focus();
    }
    function openWidget() {
      previousFocus = document.activeElement instanceof HTMLElement ? document.activeElement : null;
      panel?.classList.remove('hidden');
      panel?.classList.add('flex');
      panel?.setAttribute('aria-hidden', 'false');
      launcher?.setAttribute('aria-expanded', 'true');
      launcher?.classList.add('hidden');
      setError(null);
      messageInput?.focus();
    }
    function closeWidget() {
      panel?.classList.add('hidden');
      panel?.classList.remove('flex');
      panel?.setAttribute('aria-hidden', 'true');
      launcher?.setAttribute('aria-expanded', 'false');
      launcher?.classList.remove('hidden');
      (previousFocus || launcher)?.focus();
    }
    async function ask(question: string) {
      const trimmed = question.trim();
      if (trimmed.length < 2 || trimmed.length > 600) return;
      if (/book a live demo/i.test(trimmed)) {
        showLead();
        return;
      }
      history.push({ role: 'user', text: trimmed });
      renderBubble(trimmed, 'user');
      messageInput!.value = '';
      sendButton!.disabled = true;
      messageInput!.disabled = true;
      setError(null);
      try {
        const response = await fetch('/api/markcopilot', {
          method: 'POST',
          credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({ question: trimmed }),
          signal: AbortSignal.timeout(8500),
        });
        const payload: unknown = await response.json();
        if (!response.ok || !payload || typeof payload !== 'object' ||
          (payload as { success?: boolean }).success !== true) {
          throw new Error('Unable to load guidance');
        }
        const data = payload as { answer?: unknown; mode?: unknown };
        if (typeof data.answer !== 'string') throw new Error('Invalid response');
        setMode(data.mode === 'live' ? 'live' : 'guide');
        const answer = data.answer.slice(0, 1300);
        renderBubble(answer, 'assistant');
        history.push({ role: 'assistant', text: answer });
      } catch {
        setMode('guide');
        setError('Assistant temporarily unavailable. Email hello@markchat.co.ke for help.');
      } finally {
        sendButton!.disabled = false;
        messageInput!.disabled = false;
        messageInput!.focus();
      }
    }

    launcher.addEventListener('click', openWidget);
    close?.addEventListener('click', closeWidget);
    leadDismiss?.addEventListener('click', hideLead);
    composer.addEventListener('submit', (event) => {
      event.preventDefault();
      void ask(messageInput.value);
    });
    panel.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        event.preventDefault();
        closeWidget();
      }
      if (event.key === 'Tab') {
        const focusable = Array.from(
          panel.querySelectorAll<HTMLElement>(
            'button:not([disabled]):not(.hidden), input:not([disabled]):not(.hidden), select:not([disabled]), a[href]'
          )
        ).filter((el) => el.getClientRects().length > 0);
        if (!focusable.length) return;
        const first = focusable[0], last = focusable[focusable.length - 1];
        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
      }
    });
    document.querySelectorAll<HTMLButtonElement>('[data-mc-prompt]').forEach((button) => {
      button.addEventListener('click', () => {
        const prompt = button.dataset.mcPrompt;
        if (prompt) void ask(prompt);
      });
    });

    leadForm.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!leadForm.reportValidity()) return;
      if (leadSubmit) leadSubmit.disabled = true;
      const values = new FormData(leadForm);
      const transcriptSummary = history
        .slice(-6).map((item) => item.role + ': ' + item.text).join(' ')
        .replace(/[\r\n\x00-\x1F\x7F]/g, ' ').slice(0, 1600);
      const data = {
        name: String(values.get('name') || ''),
        email: String(values.get('email') || ''),
        phone: String(values.get('phone') || ''),
        businessName: String(values.get('businessName') || ''),
        interest: String(values.get('interest') || ''),
        transcriptSummary,
        sourcePage: window.location.pathname,
        startedAt: Number(values.get('startedAt')),
        consent: values.get('consent') === 'on',
        website: String(values.get('website') || ''),
      };
      try {
        const response = await fetch('/api/leads', {
          method: 'POST',
          credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(data),
          signal: AbortSignal.timeout(11000),
        });
        const result: unknown = await response.json();
        if (![200, 201].includes(response.status) || !result || typeof result !== 'object' ||
          (result as { success?: unknown }).success !== true) {
          throw new Error('Lead not saved');
        }
        if (leadFeedback) {
          leadFeedback.textContent = 'Your inquiry was saved successfully. Our team can follow up using your contact details.';
          leadFeedback.className = 'text-xs text-emerald-700 dark:text-emerald-300';
        }
        if (leadSubmit) leadSubmit.disabled = true;
      } catch {
        if (leadFeedback) {
          leadFeedback.textContent = 'We could not save your request. Your details are still here. Please email hello@markchat.co.ke.';
          leadFeedback.className = 'text-xs text-rose-700 dark:text-rose-300';
        }
        if (leadSubmit) leadSubmit.disabled = false;
      }
    });
    // Mobile virtual keyboards sometimes shrink only the visual viewport.
    // Keep the composer above the keyboard without moving the desktop panel.
    function syncMobileKeyboard() {
      const viewport = window.visualViewport;
      if (!viewport || !window.matchMedia('(max-width: 639px)').matches) {
        panel?.style.removeProperty('bottom');
        panel?.style.removeProperty('max-height');
        return;
      }
      const covered = Math.max(0, window.innerHeight - viewport.offsetTop - viewport.height);
      panel!.style.bottom = `calc(5rem + env(safe-area-inset-bottom) + ${Math.round(covered)}px)`;
      panel!.style.maxHeight = Math.round(viewport.height * 0.75) + 'px';
      if (document.activeElement === messageInput && list) list.scrollTop = list.scrollHeight;
    }
    syncMobileKeyboard();
    window.visualViewport?.addEventListener('resize', syncMobileKeyboard);
    window.visualViewport?.addEventListener('scroll', syncMobileKeyboard);
    window.addEventListener('resize', syncMobileKeyboard);
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeMarkChatAssistant, { once: true });
  } else {
    initializeMarkChatAssistant();
  }
  document.addEventListener('astro:page-load', initializeMarkChatAssistant);
</script>

<style>
  @media (prefers-reduced-motion: reduce) {
    #markcopilot-panel,
    #markcopilot-launcher {
      transition: none;
      transform: none;
    }
  }
</style>
