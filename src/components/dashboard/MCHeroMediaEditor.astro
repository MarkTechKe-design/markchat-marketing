---
import type { HeroMediaPage, HeroMediaSettings } from '@/lib/types';
import { normalizeHeroMedia } from '@/lib/hero-media';

interface Props {
  page: HeroMediaPage;
  settings?: Partial<HeroMediaSettings>;
  standalone?: boolean;
}
const { page, settings, standalone = false } = Astro.props;
const data = normalizeHeroMedia(page, settings, import.meta.env.PUBLIC_CMS_MEDIA_HOST || '');
const field = (name: string) => 'hero-media-' + page + '-' + name;
---

<section
  class="rounded-xl border border-border bg-surface p-4 sm:p-6"
  data-hero-media-editor={page}
>
  <div class="mb-5">
    <h3 class="text-base font-semibold text-text">Hero Background &amp; Visual Media</h3>
    <p class="mt-2 text-sm leading-relaxed text-text-muted">
      Use a bundled image path or an approved HTTPS media URL. Add a mobile crop and focal points to
      keep the subject in view on smaller screens.
    </p>
  </div>
  <div class="grid gap-4 sm:grid-cols-2">
    <div class="sm:col-span-2">
      <label class="form-label" for={field('desktop')}>Desktop / default image URL</label>
      <input
        id={field('desktop')}
        data-hero-field="heroBackgroundImageUrl"
        class="form-input w-full"
        type="text"
        placeholder="/media/editorial/image.webp"
        value={data.heroBackgroundImageUrl}
      />
    </div>
    <div class="sm:col-span-2">
      <label class="form-label" for={field('mobile')}>Mobile / tablet crop URL (optional)</label>
      <input
        id={field('mobile')}
        data-hero-field="heroBackgroundMobileImageUrl"
        class="form-input w-full"
        type="text"
        placeholder="/media/editorial/image-mobile.webp"
        value={data.heroBackgroundMobileImageUrl}
      />
    </div>
    <div class="sm:col-span-2 rounded-lg border border-border p-4">
      <p class="mb-2 text-sm font-semibold text-text">
        Upload through your authorized CMS media provider
      </p>
      <p class="mb-3 text-xs text-text-muted">
        WebP, JPEG, PNG or AVIF · 5 MB maximum. Uploading requires the connected CMS bridge's secure
        media endpoint.
      </p>
      <div class="grid gap-3 sm:grid-cols-2">
        <div>
          <label class="form-label" for={field('desktopFile')}>Desktop file</label>
          <input
            id={field('desktopFile')}
            type="file"
            data-hero-file="desktop"
            accept="image/webp,image/jpeg,image/png,image/avif"
            class="block w-full text-sm text-text"
          />
          <button type="button" data-hero-upload="desktop" class="btn btn-secondary mt-2 text-sm"
            >Upload desktop</button
          >
        </div>
        <div>
          <label class="form-label" for={field('mobileFile')}>Mobile file</label>
          <input
            id={field('mobileFile')}
            type="file"
            data-hero-file="mobile"
            accept="image/webp,image/jpeg,image/png,image/avif"
            class="block w-full text-sm text-text"
          />
          <button type="button" data-hero-upload="mobile" class="btn btn-secondary mt-2 text-sm"
            >Upload mobile</button
          >
        </div>
      </div>
      <p data-hero-upload-status aria-live="polite" class="mt-3 text-xs text-text-muted"></p>
    </div>
    <div class="sm:col-span-2">
      <label class="form-label" for={field('alt')}>Image description / alt text</label>
      <input
        id={field('alt')}
        data-hero-field="heroBackgroundAlt"
        class="form-input w-full"
        type="text"
        maxlength="180"
        value={data.heroBackgroundAlt}
      />
    </div>
    <div>
      <label class="form-label" for={field('mode')}>Display mode</label>
      <select id={field('mode')} data-hero-field="heroMediaMode" class="form-input w-full">
        <option value="layered-preview" selected={data.heroMediaMode === 'layered-preview'}
          >Layered product preview</option
        >
        <option value="editorial-backdrop" selected={data.heroMediaMode === 'editorial-backdrop'}
          >Editorial backdrop</option
        >
        <option value="hybrid" selected={data.heroMediaMode === 'hybrid'}
          >Editorial plus workflow</option
        >
      </select>
    </div>
    <div>
      <label class="form-label" for={field('scrim')}>Solid scrim strength</label>
      <select id={field('scrim')} data-hero-field="heroScrimStrength" class="form-input w-full">
        <option value="subtle" selected={data.heroScrimStrength === 'subtle'}>Subtle</option>
        <option value="medium" selected={data.heroScrimStrength === 'medium'}>Medium</option>
        <option value="strong" selected={data.heroScrimStrength === 'strong'}>Strong</option>
      </select>
    </div>
  </div>
  <fieldset class="mt-5 grid gap-4 sm:grid-cols-2">
    <legend class="mb-3 text-sm font-semibold text-text">Image focal points (0–100%)</legend>
    {
      (
        [
          ['heroFocalX', 'Desktop horizontal'],
          ['heroFocalY', 'Desktop vertical'],
          ['heroMobileFocalX', 'Mobile horizontal'],
          ['heroMobileFocalY', 'Mobile vertical'],
        ] as const
      ).map(([key, label]) => (
        <div>
          <label class="form-label" for={field(key)}>
            {label}
          </label>
          <input
            id={field(key)}
            data-hero-field={key}
            type="number"
            min="0"
            max="100"
            step="1"
            class="form-input w-full"
            value={data[key] ?? 50}
          />
        </div>
      ))
    }
  </fieldset>
  <div class="mt-5 flex items-center gap-2" role="group" aria-label="Hero preview crop">
    <button
      type="button"
      data-hero-preview-mode="desktop"
      aria-pressed="true"
      class="btn btn-secondary text-sm">Desktop preview</button
    >
    <button
      type="button"
      data-hero-preview-mode="mobile"
      aria-pressed="false"
      class="btn btn-secondary text-sm">Mobile preview</button
    >
  </div>
  <div class="mt-5 overflow-hidden rounded-lg border border-border bg-background">
    <img
      data-hero-media-preview
      alt="Hero image preview"
      class="hidden aspect-[16/10] max-h-72 w-full object-cover object-center"
      width="1600"
      height="1000"
      loading="lazy"
    />
    <div data-hero-media-empty class="p-6 text-center text-sm text-text-muted">
      No deployed hero image selected; the neutral canvas remains active.
    </div>
  </div>
  {
    standalone && (
      <div class="mt-4 flex flex-wrap items-center gap-3">
        <button type="button" class="btn btn-primary" data-hero-media-save>
          Save {page} hero media
        </button>
        <span aria-live="polite" data-hero-media-status class="text-sm text-text-muted" />
      </div>
    )
  }
</section>

<script>
  import { normalizeHeroMedia, HERO_MEDIA_PAGES } from '@/lib/hero-media';
  import {
    fetchHeroMediaSettings,
    updateHeroMediaSettings,
    uploadHeroMediaAsset,
  } from '@/lib/cms-api';
  import type { HeroMediaPage, HeroMediaSettings } from '@/lib/types';

  function collectHeroMedia(root: HTMLElement): Partial<HeroMediaSettings> {
    const value = (name: string) =>
      root.querySelector<HTMLInputElement | HTMLSelectElement>('[data-hero-field="' + name + '"]')
        ?.value || '';
    return {
      heroBackgroundImageUrl: value('heroBackgroundImageUrl'),
      heroBackgroundMobileImageUrl: value('heroBackgroundMobileImageUrl'),
      heroBackgroundAlt: value('heroBackgroundAlt'),
      heroMediaMode: value('heroMediaMode') as HeroMediaSettings['heroMediaMode'],
      heroScrimStrength: value('heroScrimStrength') as HeroMediaSettings['heroScrimStrength'],
      heroFocalX: Number(value('heroFocalX')),
      heroFocalY: Number(value('heroFocalY')),
      heroMobileFocalX: Number(value('heroMobileFocalX')),
      heroMobileFocalY: Number(value('heroMobileFocalY')),
    };
  }

  window.markchatReadHeroMedia = (page: HeroMediaPage) => {
    const root = document.querySelector<HTMLElement>('[data-hero-media-editor="' + page + '"]');
    return root ? collectHeroMedia(root) : {};
  };

  function initHeroMediaEditors() {
    document.querySelectorAll<HTMLElement>('[data-hero-media-editor]').forEach((root) => {
      if (root.dataset.initialized === 'true') return;
      root.dataset.initialized = 'true';
      const page = root.dataset.heroMediaEditor as HeroMediaPage;
      if (!HERO_MEDIA_PAGES.includes(page)) return;
      const preview = root.querySelector<HTMLImageElement>('[data-hero-media-preview]');
      const empty = root.querySelector<HTMLElement>('[data-hero-media-empty]');
      let previewMode = 'desktop';
      let dirty = false;
      const render = () => {
        const media = normalizeHeroMedia(
          page,
          collectHeroMedia(root),
          import.meta.env.PUBLIC_CMS_MEDIA_HOST || ''
        );
        const url =
          previewMode === 'mobile'
            ? media.heroBackgroundMobileImageUrl || media.heroBackgroundImageUrl
            : media.heroBackgroundImageUrl || media.heroBackgroundMobileImageUrl;
        if (!preview || !empty) return;
        if (!url) {
          preview.removeAttribute('src');
          preview.classList.add('hidden');
          empty.classList.remove('hidden');
          return;
        }
        preview.src = url;
        preview.alt = media.heroBackgroundAlt || 'Selected editorial preview';
        preview.style.objectPosition =
          previewMode === 'mobile'
            ? `${media.heroMobileFocalX}% ${media.heroMobileFocalY}%`
            : `${media.heroFocalX}% ${media.heroFocalY}%`;
        preview.classList.remove('hidden');
        empty.classList.add('hidden');
      };
      root.querySelectorAll<HTMLButtonElement>('[data-hero-preview-mode]').forEach((button) => {
        button.addEventListener('click', () => {
          previewMode = button.dataset.heroPreviewMode || 'desktop';
          root
            .querySelectorAll<HTMLButtonElement>('[data-hero-preview-mode]')
            .forEach((option) => option.setAttribute('aria-pressed', String(option === button)));
          render();
        });
      });
      if (page === 'careers') {
        void fetchHeroMediaSettings('careers')
          .then((saved) => {
            if (dirty) return;
            root
              .querySelectorAll<HTMLInputElement | HTMLSelectElement>('[data-hero-field]')
              .forEach((input) => {
                const key = input.dataset.heroField as keyof HeroMediaSettings;
                if (saved[key] !== undefined) input.value = String(saved[key]);
              });
            render();
          })
          .catch(() => {
            const status = root.querySelector<HTMLElement>('[data-hero-media-status]');
            if (status)
              status.textContent =
                'Saved settings could not be loaded. The bundled image is shown for reference.';
          });
      }
      root.querySelectorAll<HTMLButtonElement>('[data-hero-upload]').forEach((button) => {
        button.addEventListener('click', async () => {
          const variant = button.dataset.heroUpload as 'desktop' | 'mobile';
          const input = root.querySelector<HTMLInputElement>('[data-hero-file="' + variant + '"]');
          const status = root.querySelector<HTMLElement>('[data-hero-upload-status]');
          const file = input?.files?.[0];
          if (!file) {
            if (status) status.textContent = 'Select an image first.';
            return;
          }
          button.disabled = true;
          try {
            const uploadedUrl = await uploadHeroMediaAsset(page, variant, file);
            const fieldName =
              variant === 'desktop' ? 'heroBackgroundImageUrl' : 'heroBackgroundMobileImageUrl';
            const field = root.querySelector<HTMLInputElement>(
              '[data-hero-field="' + fieldName + '"]'
            );
            if (field) field.value = uploadedUrl;
            dirty = true;
            if (status)
              status.textContent =
                'Upload confirmed. Save the page settings to publish the selected media.';
            render();
          } catch (error) {
            if (status)
              status.textContent = error instanceof Error ? error.message : 'Upload failed.';
          } finally {
            button.disabled = false;
          }
        });
      });
      preview?.addEventListener('error', () => {
        preview.classList.add('hidden');
        empty?.classList.remove('hidden');
      });
      root.querySelectorAll('input,select').forEach((input) => {
        input.addEventListener('input', () => {
          dirty = true;
        });
        input.addEventListener('input', render);
        input.addEventListener('change', render);
      });
      root
        .querySelector<HTMLButtonElement>('[data-hero-media-save]')
        ?.addEventListener('click', async (event) => {
          const button = event.currentTarget as HTMLButtonElement;
          const status = root.querySelector<HTMLElement>('[data-hero-media-status]');
          button.disabled = true;
          try {
            await updateHeroMediaSettings(page, collectHeroMedia(root));
            if (status)
              status.textContent =
                page === 'careers'
                  ? 'Careers hero saved. The updated image is available on the public Careers page.'
                  : 'Saved in this browser; confirm the CMS bridge before treating it as published.';
          } catch {
            if (status) status.textContent = 'Unable to save; check your session and CMS bridge.';
          } finally {
            button.disabled = false;
          }
        });
      render();
    });
  }
  initHeroMediaEditors();
  document.addEventListener('astro:page-load', initHeroMediaEditors);
</script>
