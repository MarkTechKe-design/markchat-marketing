---
import { Icon } from 'astro-icon/components';
import MCStatusBadge from '@/components/design-system/MCStatusBadge.astro';

const integrations = [
  {
    title: 'Safaricom M-Pesa Daraja',
    icon: 'lucide:wallet-cards',
    iconClasses:
      'bg-[#43B02A]/12 text-[#15803D] border-[#43B02A]/30 dark:bg-[#43B02A]/18 dark:text-[#4ADE80] dark:border-[#43B02A]/35',
    href: '/integrations/safaricom-mpesa-daraja',
    status: 'Requires setup',
  },
  {
    title: 'Pochi la Biashara Sync',
    icon: 'lucide:receipt',
    iconClasses:
      'bg-[#0D9488]/12 text-[#0F766E] border-[#0D9488]/30 dark:bg-[#14B8A6]/18 dark:text-[#2DD4BF] dark:border-[#14B8A6]/35',
    href: '/integrations/pochi-la-biashara-sync',
    status: 'Check availability',
  },
  {
    title: 'Shared Bank Paybill',
    icon: 'lucide:landmark',
    iconClasses:
      'bg-[#1D4ED8]/12 text-[#1E40AF] border-[#1D4ED8]/30 dark:bg-[#3B82F6]/18 dark:text-[#93C5FD] dark:border-[#3B82F6]/35',
    href: '/integrations/shared-bank-paybill',
    status: 'Check availability',
  },
  {
    title: "Africa's Talking SMS",
    icon: 'lucide:smartphone',
    iconClasses:
      'bg-[#F59E0B]/14 text-[#B45309] border-[#F59E0B]/30 dark:bg-[#F59E0B]/18 dark:text-[#FBBF24] dark:border-[#F59E0B]/35',
    href: '/integrations/africas-talking-bulk-sms',
    status: 'Separate SMS service',
  },
  {
    title: 'Shopify',
    icon: 'lucide:shopping-bag',
    iconClasses:
      'bg-[#95BF47]/15 text-[#3F6212] border-[#95BF47]/35 dark:bg-[#95BF47]/20 dark:text-[#A3E635] dark:border-[#95BF47]/35',
    href: '/integrations/shopify',
    status: 'Requires setup',
  },
  {
    title: 'REST APIs & Webhooks',
    icon: 'lucide:braces',
    iconClasses:
      'bg-[#7C3AED]/12 text-[#6D28D9] border-[#7C3AED]/30 dark:bg-[#8B5CF6]/18 dark:text-[#C4B5FD] dark:border-[#8B5CF6]/35',
    href: '/integrations/developer-api-webhooks',
    status: 'Developer setup',
  },
  {
    title: 'Google SSO',
    icon: 'lucide:key-round',
    iconClasses:
      'bg-[#EA4335]/12 text-[#B91C1C] border-[#EA4335]/30 dark:bg-[#EF4444]/18 dark:text-[#FCA5A5] dark:border-[#EF4444]/35',
    href: '/integrations/google-microsoft-sso',
    status: 'Check availability',
  },
];
---

<section aria-label="Business and developer integrations" class="min-w-0">
  <div class="mc-integration-viewport" data-mc-integration-rail>
    <div class="mc-integration-track">
      <div class="mc-integration-group">
        {
          integrations.map((integration) => (
            <a
              href={integration.href}
              class="inline-flex min-w-60 shrink-0 items-center gap-3 rounded-xl border border-border bg-surface-elevated px-4 py-3 text-text transition-colors hover:border-primary/50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
            >
              <span
                data-mc-brand-icon={integration.title}
                class:list={[
                  'flex h-5 w-5 shrink-0 items-center justify-center rounded-md border',
                  integration.iconClasses,
                ]}
              >
                <Icon name={integration.icon} class="h-4 w-4" />
              </span>
              <span class="min-w-0">
                <span class="block text-xs font-semibold">{integration.title}</span>
                <MCStatusBadge label={integration.status} />
              </span>
            </a>
          ))
        }
      </div>
      <div class="mc-integration-group" aria-hidden="true">
        {
          integrations.map((integration) => (
            <span class="inline-flex min-w-60 shrink-0 items-center gap-3 rounded-xl border border-border bg-surface-elevated px-4 py-3 text-text">
              <span
                data-mc-brand-icon={integration.title}
                class:list={[
                  'flex h-5 w-5 shrink-0 items-center justify-center rounded-md border',
                  integration.iconClasses,
                ]}
              >
                <Icon name={integration.icon} class="h-4 w-4" />
              </span>
              <span class="min-w-0">
                <span class="block text-xs font-semibold">{integration.title}</span>
                <span class="text-xs text-text-muted">{integration.status}</span>
              </span>
            </span>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .mc-integration-viewport {
    overflow: hidden;
    mask-image: linear-gradient(to right, transparent, #000 5%, #000 95%, transparent);
    -webkit-mask-image: linear-gradient(to right, transparent, #000 5%, #000 95%, transparent);
  }
  .mc-integration-track {
    display: flex;
    width: max-content;
    animation: mc-marquee-right 48s linear infinite;
    will-change: transform;
  }
  .mc-integration-group {
    display: flex;
    flex: 0 0 auto;
    gap: 0.75rem;
    padding-right: 0.75rem;
  }
  .mc-integration-viewport:hover .mc-integration-track,
  .mc-integration-viewport:focus-within .mc-integration-track {
    animation-play-state: paused;
  }
  @keyframes mc-marquee-right {
    from {
      transform: translate3d(-50%, 0, 0);
    }
    to {
      transform: translate3d(0, 0, 0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .mc-integration-viewport {
      overflow-x: auto;
      mask-image: none;
      -webkit-mask-image: none;
    }
    .mc-integration-track {
      animation: none;
      will-change: auto;
    }
    .mc-integration-group[aria-hidden='true'] {
      display: none;
    }
  }
</style>
