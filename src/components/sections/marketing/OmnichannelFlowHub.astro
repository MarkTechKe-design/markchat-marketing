---
import MCContainer from '@/components/design-system/MCContainer.astro';
import SlidingChannelRail from '@/components/motion/SlidingChannelRail.astro';
import SlidingIntegrationRail from '@/components/motion/SlidingIntegrationRail.astro';

---

<section
  class="border-b border-border bg-surface py-10 sm:py-12"
  aria-label="Customer channels and business integrations"
>
  <MCContainer class="max-w-[1360px]">
    <div class="mb-6 flex flex-wrap items-end justify-between gap-3">
      <div>
        <p class="text-xs font-bold uppercase tracking-widest text-primary">
          Work with your customers' channels
        </p>
        <h2 class="mt-2 text-xl font-bold text-text sm:text-2xl">
          Conversations and commerce, connected.
        </h2>
      </div>
      <a href="/integrations" class="text-sm font-semibold text-primary hover:underline"
        >Integration setup and availability →</a
      >
    </div>
    <div class="space-y-4" aria-label="Integration discovery rails">
      <SlidingChannelRail />
      <SlidingIntegrationRail />
    </div>
  </MCContainer>
</section>
