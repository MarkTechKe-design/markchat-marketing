---
import { Icon } from 'astro-icon/components';

interface Props {
  kind?: 'talent' | 'role';
}
const { kind = 'role' } = Astro.props;
---

<div
  role="status"
  class="rounded-2xl border border-slate-200 bg-slate-50 p-5 text-slate-900 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 sm:p-6"
  data-careers-applications-paused
>
  <div
    class="mb-4 inline-flex items-center gap-2 rounded-full border border-amber-200 bg-amber-50 px-3 py-1.5 text-xs font-semibold text-amber-900 dark:border-amber-900 dark:bg-amber-950 dark:text-amber-200"
  >
    <Icon name="lucide:shield-check" class="size-4" aria-hidden="true" />
    Recruitment currently closed
  </div>
  <h3 class="text-lg font-bold tracking-tight">
    {
      kind === 'talent'
        ? 'General applications are closed'
        : 'No open applications at the moment'
    }
  </h3>
  <p class="mt-3 text-sm leading-relaxed text-slate-600 dark:text-slate-300">
    We're not currently accepting applications. Thank you for your interest in MarkChat.
    Please check back here for future opportunities.
  </p>
  <p class="mt-4 text-sm text-slate-600 dark:text-slate-300">
    For general recruitment questions (please don't send CV attachments), contact
    <a
      href="mailto:hello@markchat.co.ke"
      class="font-semibold text-blue-700 underline underline-offset-2 dark:text-blue-300"
      >hello@markchat.co.ke</a
    >.
  </p>
</div>
