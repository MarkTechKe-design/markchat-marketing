---
interface Props {
  className?: string;
}
const { className = '' } = Astro.props;
---

<figure
  class:list={[
    'overflow-hidden rounded-2xl border border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900',
    className,
  ]}
>
  <div class="relative aspect-[16/10] w-full overflow-hidden">
    <img
      src="/images/careers-hero.webp"
      alt="Two professionals working at laptops in a shared office."
      width="1600"
      height="1066"
      decoding="async"
      loading="eager"
      fetchpriority="high"
      class="careers-hero-picture absolute inset-0 block h-full w-full object-cover"
    />
  </div>
</figure>

<style>
  .careers-hero-picture {
    object-position: 62% 50%;
  }
  @media (max-width: 767px) {
    .careers-hero-picture {
      object-position: 65% 50%;
    }
  }
</style>
