---
interface Props {
  kind: 'role' | 'talent_pool';
}
const { kind } = Astro.props;
---

<form data-career-application-form data-kind={kind} class="space-y-5" novalidate>
  <div class="grid gap-4 sm:grid-cols-2">
    <label class="block text-sm font-medium">
      Full name *
      <input name="fullName" required maxlength="160" autocomplete="name"
        class="mt-2 w-full rounded-xl border border-border bg-white p-3 text-slate-900 dark:bg-background dark:text-white" />
    </label>
    <label class="block text-sm font-medium">
      Email *
      <input name="email" required type="email" maxlength="254" autocomplete="email"
        class="mt-2 w-full rounded-xl border border-border bg-white p-3 text-slate-900 dark:bg-background dark:text-white" />
    </label>
    <label class="block text-sm font-medium">
      Telephone *
      <input name="phone" required type="tel" maxlength="40" autocomplete="tel"
        class="mt-2 w-full rounded-xl border border-border bg-white p-3 text-slate-900 dark:bg-background dark:text-white" />
    </label>
    <label class="block text-sm font-medium">
      LinkedIn (optional)
      <input name="linkedinUrl" type="url" maxlength="500" autocomplete="url" placeholder="https://linkedin.com/in/..."
        class="mt-2 w-full rounded-xl border border-border bg-white p-3 text-slate-900 dark:bg-background dark:text-white" />
    </label>
    <label class="block text-sm font-medium sm:col-span-2">
      Portfolio (optional)
      <input name="portfolioUrl" type="url" maxlength="500" placeholder="https://..."
        class="mt-2 w-full rounded-xl border border-border bg-white p-3 text-slate-900 dark:bg-background dark:text-white" />
    </label>
    <label class="block text-sm font-medium sm:col-span-2">
      Short introduction (optional)
      <textarea name="coverLetter" rows="4" maxlength="4000"
        class="mt-2 w-full rounded-xl border border-border bg-white p-3 text-slate-900 dark:bg-background dark:text-white"></textarea>
    </label>
    <label class="block text-sm font-medium sm:col-span-2">
      CV — PDF or DOCX, maximum 5 MB *
      <input name="resume" type="file" accept=".pdf,.docx,application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document" required
        class="mt-2 block w-full rounded-xl border border-border p-3 text-sm" />
    </label>
  </div>
  <label class="flex items-start gap-3 text-sm leading-relaxed">
    <input name="consent" type="checkbox" required class="mt-1 size-4 shrink-0" />
    <span>I consent to MarkChat processing my application and CV for recruitment purposes, as described in the <a href="/privacy" target="_blank" rel="noopener" class="font-semibold text-blue-600 underline dark:text-blue-300">Privacy Policy</a>.</span>
  </label>
  <button type="submit" class="rounded-xl bg-[#1D4ED8] px-6 py-3 text-sm font-semibold text-white hover:bg-blue-800 disabled:cursor-not-allowed disabled:opacity-60">
    Submit application
  </button>
  <p data-career-status role="status" aria-live="polite" class="text-sm text-slate-600 dark:text-slate-300"></p>
</form>

<script>
  function initCareersApplicationForms() {
    for (const form of document.querySelectorAll<HTMLFormElement>('[data-career-application-form]')) {
      if (form.dataset.bound) continue;
      form.dataset.bound = 'true';
      const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      const status = form.querySelector<HTMLElement>('[data-career-status]');
      let idempotencyKey = crypto.randomUUID().replace(/-/g, '');

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (!form.reportValidity()) return;
        const input = (name: string) => (form.elements.namedItem(name) as HTMLInputElement | null)?.value?.trim() || '';
        const file = (form.elements.namedItem('resume') as HTMLInputElement | null)?.files?.[0];
        const consent = (form.elements.namedItem('consent') as HTMLInputElement | null)?.checked === true;
        if (!file || file.size > 5 * 1024 * 1024 || !/\.(pdf|docx)$/i.test(file.name)) {
          if (status) status.textContent = 'Please choose a PDF or DOCX CV of 5 MB or less.';
          return;
        }
        const kind = form.dataset.kind === 'talent_pool' ? 'talent_pool' : 'role';
        const roleId = form.dataset.roleId || null;
        if (kind === 'role' && !roleId) {
          if (status) status.textContent = 'This position is not accepting applications.';
          return;
        }
        if (submit) submit.disabled = true;
        if (status) status.textContent = 'Securely submitting your application...';
        try {
          const encoded = await new Promise<string>((resolve, reject) => {
            const reader = new FileReader();
            reader.onerror = () => reject(new Error('Unable to read CV'));
            reader.onload = () => {
              const text = String(reader.result || '');
              const result = text.split(',')[1];
              if (!result) reject(new Error('Unable to encode CV'));
              else resolve(result);
            };
            reader.readAsDataURL(file);
          });
          const payload = {
            kind, ...(kind === 'role' ? { roleId } : {}),
            fullName: input('fullName'),
            email: input('email'),
            phone: input('phone'),
            linkedinUrl: input('linkedinUrl') || null,
            portfolioUrl: input('portfolioUrl') || null,
            coverLetter: (form.elements.namedItem('coverLetter') as HTMLTextAreaElement | null)?.value?.trim() || null,
            filename: file.name,
            fileBase64: encoded,
            consent,
            consentVersion: '2026-11',
            idempotencyKey,
          };
          const response = await fetch('/api/careers/apply', {
            method: 'POST',
            cache: 'no-store',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });
          const result = await response.json().catch(() => null);
          if (response.status !== 201 || result?.success !== true ||
              typeof result.id !== 'string' || !result.id) {
            throw new Error('We could not confirm receipt of your application. Please try again later.');
          }
          form.reset();
          idempotencyKey = crypto.randomUUID().replace(/-/g, '');
          if (status) status.textContent =
            'Application received. Thank you for applying to MarkChat. Reference: ' + result.id;
        } catch (error) {
          if (status) status.textContent = error instanceof Error ? error.message :
            'Your application could not be confirmed. Please try again.';
        } finally {
          if (submit) submit.disabled = false;
        }
      });
    }
  }
  initCareersApplicationForms();
  document.addEventListener('astro:page-load', initCareersApplicationForms);
</script>
