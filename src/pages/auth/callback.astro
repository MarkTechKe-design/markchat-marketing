---
/**
 * OAuth Callback Page - Handles Google OAuth 2.0 + PKCE return
 *
 * Implemented using AuthLayout with noindex.
 * Redeems a single-use, browser-bound ticket through the verified Control Plane
 * API. No JWT or Core SSO secret is accepted from URL fragments.
 */
import AuthLayout from '@/layouts/AuthLayout.astro';

const controlPlaneUrl =
  import.meta.env.PUBLIC_CONTROL_PLANE_URL ||
  import.meta.env.PUBLIC_CONTROL_PLANE_API_URL ||
  'http://localhost:5000';
---

<AuthLayout
  title="Signing in with Google | MarkChat"
  description="Completing Google authentication and workspace session initialization."
  pageType="login"
  noindex={true}
>
  <div class="w-full max-w-md mx-auto" id="oauth-exchange" data-api-url={controlPlaneUrl}>
    <div class="bg-surface border border-border rounded-2xl p-6 sm:p-8 shadow-sm">
      <!-- Loading State -->
      <div id="oauth-loading-state" class="text-center py-6 space-y-4">
        <div class="flex justify-center">
          <svg
            class="animate-spin w-10 h-10 text-primary"
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"
            ></circle>
            <path
              class="opacity-75"
              fill="currentColor"
              d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
            ></path>
          </svg>
        </div>
        <div>
          <h1 class="text-lg font-semibold text-text">Completing Google sign-in...</h1>
          <p class="text-xs text-text-muted mt-1 leading-relaxed">
            Initializing your MarkChat workspace session. You will be redirected momentarily.
          </p>
        </div>
      </div>

      <!-- Error State (Hidden by default) -->
      <div id="oauth-error-state" class="hidden text-center py-4 space-y-4" role="alert">
        <div
          class="w-12 h-12 mx-auto rounded-full bg-error-bg border border-error/30 flex items-center justify-center text-error"
        >
          <svg
            class="w-6 h-6"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
            ></path>
          </svg>
        </div>
        <div>
          <h2 class="text-base font-semibold text-text">Google Sign-in Failed</h2>
          <p id="oauth-error-message" class="text-xs text-text-muted mt-1 leading-relaxed">
            No valid authentication token was received or the session has expired.
          </p>
        </div>
        <div class="pt-2">
          <a
            href="/login"
            class="inline-flex items-center justify-center h-10 px-6 rounded-xl bg-primary hover:bg-primary-dark text-white font-medium text-xs transition-colors shadow-xs"
          >
            Return to sign in &rarr;
          </a>
        </div>
      </div>
    </div>
  </div>
</AuthLayout>

<script>
  (async function redeemGoogleSession() {
    const loading = document.getElementById('oauth-loading-state');
    const errorPanel = document.getElementById('oauth-error-state');
    const errorMessage = document.getElementById('oauth-error-message');
    function fail() {
      loading?.classList.add('hidden');
      errorPanel?.classList.remove('hidden');
      if (errorMessage) errorMessage.textContent =
        'Google sign-in could not be verified. Please restart the sign-in process.';
    }
    const params = new URLSearchParams(window.location.search);
    const ticket = params.get('ticket');
    const hadFragment = Boolean(window.location.hash);
    // Strip handoff selector and any malicious fragment before making requests.
    window.history.replaceState({}, document.title, window.location.pathname);
    if (hadFragment || !ticket || !/^[A-Za-z0-9_-]{43}$/.test(ticket)) {
      fail();
      return;
    }
    const apiUrl = (document.getElementById('oauth-exchange') as HTMLElement)?.dataset.apiUrl;
    if (!apiUrl) { fail(); return; }
    try {
      const response = await fetch(apiUrl.replace(/\/$/, '') + '/api/v1/auth/google/exchange', {
        method: 'POST',
        credentials: 'include',
        cache: 'no-store',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ ticket })
      });
      if (!response.ok) throw new Error('OAuth handoff rejected');
      const payload = (await response.json()).data;
      if (typeof payload?.token !== 'string' || payload.token.split('.').length !== 3)
        throw new Error('Missing verified session');
      const redirect = payload.redirect;
      const safeRedirect =
        typeof redirect === 'string' &&
        redirect.length <= 512 &&
        /^\/(?![/\\])/.test(redirect) &&
        !Array.from(redirect).some(
          (char) => char === '\\' || char.charCodeAt(0) < 32 || char.charCodeAt(0) === 127
        ) &&
        !/%(?:2f|5c|2e|25)/i.test(redirect) &&
        !redirect.includes(':') && !redirect.includes('#')
          ? redirect : '/billing';
      localStorage.setItem('markchat_cp_token', payload.token);
      let destination = safeRedirect;
      if (typeof payload.ssoUrl === 'string' && !payload.isNewUser) {
        const link = new URL(payload.ssoUrl);
        const allowed = new Set(['https://app.markchat.co.ke',
          'http://localhost:3000', 'http://127.0.0.1:3000']);
        if (allowed.has(link.origin) && link.pathname.startsWith('/app/'))
          destination = link.toString();
      }
      window.location.replace(destination);
    } catch {
      fail();
    }
  })();
</script>
