---
/**
 * MarkChat Kenya — Job Detail & Application Page
 *
 * Implements:
 * - Google Schema.org JobPosting structured data
 * - Virex typography & layout hierarchy
 * - Comprehensive role specifications (Responsibilities, Requirements, Benefits)
 * - Interactive application modal with Kenya DPA 2019 consent
 * - Related open positions
 * - Full dark mode parity (dark:bg-background)
 */
import MarketingLayout from '@/layouts/MarketingLayout.astro';
import CareerApplicationForm from '@/components/careers/CareerApplicationForm.astro';
import { Icon } from 'astro-icon/components';
import { siteConfig } from '@/config';
import { fetchCareers, type Career } from '@/lib/cms-api';

export async function getStaticPaths() {
  const careers = await fetchCareers();
  return careers.map((job) => ({
    params: { slug: job.slug || job.id },
    props: { job, allJobs: careers },
  }));
}

interface Props {
  job: Career;
  allJobs: Career[];
}

const { job, allJobs } = Astro.props;

// Related roles (excluding current)
const relatedJobs = allJobs.filter((j) => j.id !== job.id).slice(0, 3);

// Department accent styling
const DEPT_ACCENTS: Record<string, { bg: string; text: string; border: string }> = {
  Engineering: {
    bg: 'bg-indigo-50 dark:bg-indigo-950/70',
    text: 'text-indigo-600 dark:text-indigo-400',
    border: 'border-indigo-200/80 dark:border-indigo-800/80',
  },
  'Customer Operations': {
    bg: 'bg-emerald-50 dark:bg-emerald-950/70',
    text: 'text-emerald-600 dark:text-emerald-400',
    border: 'border-emerald-200/80 dark:border-emerald-800/80',
  },
  'Developer Relations': {
    bg: 'bg-cyan-50 dark:bg-cyan-950/70',
    text: 'text-cyan-600 dark:text-cyan-400',
    border: 'border-cyan-200/80 dark:border-cyan-800/80',
  },
  'Growth & Sales': {
    bg: 'bg-purple-50 dark:bg-purple-950/70',
    text: 'text-purple-600 dark:text-purple-400',
    border: 'border-purple-200/80 dark:border-purple-800/80',
  },
};

const deptAccent = DEPT_ACCENTS[job.department] || {
  bg: 'bg-blue-50 dark:bg-blue-950/70',
  text: 'text-blue-600 dark:text-blue-400',
  border: 'border-blue-200/80 dark:border-blue-800/80',
};

const arrangement = job.workArrangement || 'Hybrid';
const experience = job.experienceLevel || job.experience || 'Mid-Level';

// Google JobPosting Structured Data Schema
const jobPostingSchema = {
  '@context': 'https://schema.org',
  '@type': 'JobPosting',
  title: job.title,
  description: `${job.description} Responsibilities: ${job.responsibilities.join('; ')}. Requirements: ${job.requirements.join('; ')}.`,
  identifier: {
    '@type': 'PropertyValue',
    name: 'MarkChat Kenya',
    value: job.id,
  },
  datePosted: job.postedDate,
  validThrough: job.applicationDeadline || '2026-12-31',
  employmentType: 'FULL_TIME',
  hiringOrganization: {
    '@type': 'Organization',
    name: 'MarkChat Kenya',
    sameAs: 'https://markchat.co.ke',
    logo: 'https://markchat.co.ke/android-chrome-512x512.png',
  },
  jobLocation: {
    '@type': 'Place',
    address: {
      '@type': 'PostalAddress',
      streetAddress: 'Westlands Commercial Hub',
      addressLocality: 'Nairobi',
      addressRegion: 'Nairobi County',
      addressCountry: 'KE',
    },
  },
  applicantLocationRequirements: {
    '@type': 'Country',
    name: 'Kenya',
  },
  jobLocationType: arrangement === 'Remote' ? 'TELECOMMUTE' : undefined,
  baseSalary: job.salaryRange
    ? {
        '@type': 'MonetaryAmount',
        currency: 'KES',
        value: {
          '@type': 'QuantitativeValue',
          unitText: 'MONTH',
        },
      }
    : undefined,
};
---

<MarketingLayout
  title={`${job.seoTitle || `${job.title} — Careers at ${siteConfig.name}`}`}
  description={job.seoDescription || job.shortDescription || job.description}
>
  {/* Google JobPosting JSON-LD Structured Data */}
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(jobPostingSchema).replace(/</g, '\\u003c')}
  />

  <div
    class="py-12 sm:py-16 bg-slate-50 dark:bg-background min-h-screen text-slate-800 dark:text-slate-200 transition-colors duration-200"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      {/* Top Breadcrumb Navigation */}
      <nav
        aria-label="Breadcrumb"
        class="mb-8 flex flex-wrap items-center justify-between gap-3 border-b border-border dark:border-border pb-4"
      >
        <ol
          class="flex min-w-0 flex-wrap items-center gap-2 text-sm text-slate-500 dark:text-slate-400"
        >
          <li>
            <a
              href="/careers"
              class="hover:text-blue-600 dark:hover:text-blue-400 font-medium transition-colors"
            >
              Careers
            </a>
          </li>
          <li aria-hidden="true">/</li>
          <li>
            <span class="text-slate-600 dark:text-slate-400 font-medium">{job.department}</span>
          </li>
          <li aria-hidden="true">/</li>
          <li>
            <span class="text-slate-900 dark:text-white font-semibold wrap-break-word">
              {job.title}
            </span>
          </li>
        </ol>
        <a
          href="/careers"
          class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-semibold text-blue-600 dark:text-blue-400 hover:underline shrink-0"
        >
          <span>&larr; All Roles</span>
        </a>
      </nav>

      {/* Hero Header */}
      <header class="mb-12 pb-8 border-b border-border dark:border-border">
        <div class="flex flex-wrap items-center gap-2 mb-4">
          <span
            class:list={[
              'inline-block px-3 py-1 rounded-md text-xs font-bold uppercase tracking-wider border',
              deptAccent.bg,
              deptAccent.text,
              deptAccent.border,
            ]}
          >
            {job.department}
          </span>
          <span
            class="inline-block px-3 py-1 rounded-md text-xs font-semibold bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300"
          >
            {arrangement}
          </span>
          <span
            class="inline-block px-3 py-1 rounded-md text-xs font-semibold bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300"
          >
            {job.type}
          </span>
          <span
            class="inline-block px-3 py-1 rounded-md text-xs font-semibold bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300"
          >
            Level: {experience}
          </span>
        </div>

        <h1
          class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 dark:text-white tracking-tight leading-tight mb-4"
        >
          {job.title}
        </h1>

        <div class="flex flex-wrap items-center gap-6 text-sm text-slate-600 dark:text-slate-400">
          <span class="flex items-center gap-1.5">
            <Icon name="lucide:map-pin" class="w-4 h-4 text-slate-400" />
            <span>{job.location}</span>
          </span>
          {
            job.salaryRange && (
              <span class="flex items-center gap-1.5 font-mono text-slate-900 dark:text-slate-100 font-semibold">
                <Icon name="lucide:credit-card" class="w-4 h-4 text-emerald-500" />
                <span>{job.salaryRange}</span>
              </span>
            )
          }
          {
            job.applicationDeadline && (
              <span class="flex items-center gap-1.5 text-slate-500 dark:text-slate-400">
                <Icon name="lucide:calendar" class="w-4 h-4 text-slate-400" />
                <span>Deadline: {job.applicationDeadline}</span>
              </span>
            )
          }
        </div>
        <a
          href="#apply"
          class="mt-6 inline-flex items-center gap-2 rounded-xl bg-[#1D4ED8] px-5 py-3 text-sm font-semibold text-white hover:bg-blue-800 lg:hidden"
        >
          <Icon name="lucide:send" class="size-4" aria-hidden="true" />
          Apply for this role
        </a>
      </header>

      {/* 2-Column Content Grid */}
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12">
        {/* Main Job Description Column */}
        <article class="min-w-0 space-y-10 lg:col-span-8">
          {/* Overview */}
          <section>
            <h2 class="text-xl font-bold text-slate-900 dark:text-white mb-3">About the Role</h2>
            <p class="text-base text-slate-700 dark:text-slate-300 leading-relaxed">
              {job.description}
            </p>
          </section>

          {/* Responsibilities */}
          {
            job.responsibilities && job.responsibilities.length > 0 && (
              <section>
                <h2 class="text-xl font-bold text-slate-900 dark:text-white mb-4">
                  What You'll Do &amp; Own
                </h2>
                <ul class="space-y-3">
                  {job.responsibilities.map((item) => (
                    <li class="flex items-start gap-3 text-sm sm:text-base text-slate-700 dark:text-slate-300 leading-relaxed">
                      <span class="w-5 h-5 rounded-full bg-blue-100 dark:bg-blue-950/80 text-blue-600 dark:text-blue-400 flex items-center justify-center shrink-0 mt-0.5 font-bold text-xs">
                        &check;
                      </span>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </section>
            )
          }

          {/* Requirements */}
          {
            job.requirements && job.requirements.length > 0 && (
              <section>
                <h2 class="text-xl font-bold text-slate-900 dark:text-white mb-4">
                  Requirements &amp; Qualifications
                </h2>
                <ul class="space-y-3">
                  {job.requirements.map((item) => (
                    <li class="flex items-start gap-3 text-sm sm:text-base text-slate-700 dark:text-slate-300 leading-relaxed">
                      <span class="w-5 h-5 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400 flex items-center justify-center shrink-0 mt-0.5 font-bold text-xs">
                        &bull;
                      </span>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </section>
            )
          }

          {/* Preferred Qualifications */}
          {
            job.preferredQualifications && job.preferredQualifications.length > 0 && (
              <section>
                <h2 class="text-xl font-bold text-slate-900 dark:text-white mb-4">
                  Preferred Qualifications
                </h2>
                <ul class="space-y-3">
                  {job.preferredQualifications.map((item) => (
                    <li class="flex items-start gap-3 text-sm sm:text-base text-slate-700 dark:text-slate-300 leading-relaxed">
                      <span class="w-5 h-5 rounded-full bg-purple-100 dark:bg-purple-950/80 text-purple-600 dark:text-purple-400 flex items-center justify-center shrink-0 mt-0.5 font-bold text-xs">
                        +
                      </span>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </section>
            )
          }

          {/* Benefits */}
          {
            job.benefits && job.benefits.length > 0 && (
              <section class="p-6 sm:p-8 rounded-2xl bg-white dark:bg-surface border border-border shadow-lg shadow-slate-900/5 dark:shadow-black/20">
                <h2 class="text-xl font-bold text-slate-900 dark:text-white mb-4">What We Offer</h2>
                <ul class="space-y-3">
                  {job.benefits.map((b) => (
                    <li class="flex items-start gap-3 text-sm text-slate-700 dark:text-slate-300">
                      <Icon
                        name="lucide:sparkles"
                        class="w-4 h-4 text-emerald-500 shrink-0 mt-0.5"
                      />
                      <span>{b}</span>
                    </li>
                  ))}
                </ul>
              </section>
            )
          }

          {/* How to Apply Section */}
          <section class="pt-6 border-t border-border dark:border-border">
            <h2 class="text-xl font-bold text-slate-900 dark:text-white mb-3">
              Application &amp; Interview Process
            </h2>
            <ol class="space-y-4 text-sm text-slate-700 dark:text-slate-300">
              <li class="flex gap-3">
                <span
                  class="w-6 h-6 rounded-full bg-blue-600 text-white flex items-center justify-center font-bold text-xs shrink-0"
                  >1</span
                >
                <div>
                  <strong class="text-slate-900 dark:text-white">Initial Review:</strong> Our talent leads
                  review your CV, GitHub, or portfolio within 48 hours.
                </div>
              </li>
              <li class="flex gap-3">
                <span
                  class="w-6 h-6 rounded-full bg-blue-600 text-white flex items-center justify-center font-bold text-xs shrink-0"
                  >2</span
                >
                <div>
                  <strong class="text-slate-900 dark:text-white"
                    >Technical / Practical Assessment:</strong
                  > A real-world challenge simulating MarkChat workflows (Daraja callbacks, onboarding,
                  or commercial discovery).
                </div>
              </li>
              <li class="flex gap-3">
                <span
                  class="w-6 h-6 rounded-full bg-blue-600 text-white flex items-center justify-center font-bold text-xs shrink-0"
                  >3</span
                >
                <div>
                  <strong class="text-slate-900 dark:text-white">Team Fit Conversation:</strong> Meet
                  the team in our Westlands office or via Google Meet.
                </div>
              </li>
            </ol>
          </section>
          <section
            id="apply"
            class="scroll-mt-28 rounded-2xl border border-border bg-white p-4 shadow-lg shadow-slate-900/5 dark:bg-surface dark:shadow-black/20 sm:p-8"
          >
            <h2 class="mb-6 text-2xl font-bold tracking-tight text-slate-900 dark:text-white">
              Apply for this role
            </h2>
            <CareerApplicationForm careerId={job.id} careerTitle={job.title} />
          </section>
        </article>

        {/* Sticky Sidebar Apply Card */}
        <aside class="min-w-0 lg:col-span-4">
          <div class="space-y-6 lg:sticky lg:top-28">
            <div
              class="p-6 sm:p-8 rounded-2xl bg-white dark:bg-surface border border-border shadow-lg shadow-slate-900/5 dark:shadow-black/20"
            >
              <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-2">
                Apply for this Position
              </h3>
              <p class="text-xs text-slate-500 dark:text-slate-400 mb-6">
                Submit your CV and details directly to our Nairobi hiring team.
              </p>

              <a
                href="#apply"
                class="w-full inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-semibold text-sm shadow-none transition-colors cursor-pointer"
              >
                <Icon name="lucide:send" class="w-4 h-4" />
                <span>Apply for this Role</span>
              </a>

              <div
                class="mt-6 pt-6 border-t border-border dark:border-border space-y-3 text-xs text-slate-600 dark:text-slate-400"
              >
                <div class="flex items-center justify-between gap-3">
                  <span class="text-slate-500 dark:text-slate-400">Department:</span>
                  <span class="font-medium text-slate-800 dark:text-slate-200"
                    >{job.department}</span
                  >
                </div>
                <div class="flex items-center justify-between gap-3">
                  <span class="text-slate-500 dark:text-slate-400">Arrangement:</span>
                  <span class="font-medium text-slate-800 dark:text-slate-200">{arrangement}</span>
                </div>
                <div class="flex items-center justify-between gap-3">
                  <span class="text-slate-500 dark:text-slate-400">Experience:</span>
                  <span class="font-medium text-slate-800 dark:text-slate-200">{experience}</span>
                </div>
                {
                  job.salaryRange && (
                    <div class="flex items-center justify-between">
                      <span class="text-slate-400">Compensation:</span>
                      <span class="font-mono font-semibold text-emerald-600 dark:text-emerald-400">
                        {job.salaryRange}
                      </span>
                    </div>
                  )
                }
              </div>

              <div class="mt-6 pt-6 border-t border-border dark:border-border">
                <span class="block text-xs font-bold text-slate-400 uppercase tracking-wider mb-2">
                  Share this Opening
                </span>
                <div class="flex items-center gap-2">
                  <button
                    type="button"
                    id="copy-job-link-btn"
                    class="px-3 py-1.5 rounded-lg border border-border dark:border-border text-xs font-medium text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800 flex items-center gap-1.5 cursor-pointer"
                  >
                    <Icon name="lucide:copy" class="w-3.5 h-3.5" />
                    <span id="copy-text" aria-live="polite">Copy Link</span>
                  </button>
                </div>
              </div>
            </div>

            <div
              class="p-5 rounded-xl bg-blue-50/50 dark:bg-blue-950/30 border border-blue-200/60 dark:border-blue-900/40 text-xs text-slate-600 dark:text-slate-400 leading-relaxed"
            >
              <strong class="text-blue-700 dark:text-blue-300 block mb-1"
                >Equal Opportunity Employer:</strong
              >
              MarkChat is an equal-opportunity employer. We evaluate candidates based on skills, impact,
              and curiosity without regard to gender, ethnicity, age, or background.
            </div>
          </div>
        </aside>
      </div>

      {/* Related Positions Footer */}
      {
        relatedJobs.length > 0 && (
          <section class="mt-20 pt-12 border-t border-border dark:border-border">
            <div class="mb-8 flex flex-wrap items-center justify-between gap-3">
              <h2 class="text-2xl font-bold text-slate-900 dark:text-white tracking-tight">
                Other Open Positions at MarkChat
              </h2>
              <a
                href="/careers"
                class="text-xs sm:text-sm font-semibold text-blue-600 dark:text-blue-400 hover:underline"
              >
                View all roles &rarr;
              </a>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
              {relatedJobs.map((rJob) => (
                <a
                  href={`/careers/${rJob.slug || rJob.id}`}
                  class="p-6 rounded-2xl bg-white dark:bg-surface border border-border hover:border-blue-500/50 shadow-lg shadow-slate-900/5 dark:shadow-black/20 motion-safe:transform-gpu motion-safe:transition-transform motion-safe:duration-200 motion-safe:hover:-translate-y-1 group flex flex-col justify-between"
                >
                  <div>
                    <span class="inline-block px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 mb-2">
                      {rJob.department}
                    </span>
                    <h3 class="text-base font-bold text-slate-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors mb-2">
                      {rJob.title}
                    </h3>
                    <p class="text-xs text-slate-500 dark:text-slate-400 line-clamp-2">
                      {rJob.shortDescription || rJob.description}
                    </p>
                  </div>
                  <div class="pt-4 border-t border-border dark:border-border mt-4 flex items-center justify-between text-xs font-semibold text-blue-600 dark:text-blue-400">
                    <span>View Role</span>
                    <span>&rarr;</span>
                  </div>
                </a>
              ))}
            </div>
          </section>
        )
      }
    </div>
  </div>
</MarketingLayout>

<script>
  function setupJobShare() {
    const button = document.querySelector<HTMLButtonElement>('#copy-job-link-btn');
    const label = document.getElementById('copy-text');
    if (!button || !label || button.dataset.bound) return;
    button.dataset.bound = 'true';

    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(window.location.href);
        label.textContent = 'Copied!';
      } catch {
        label.textContent = 'Copy from address bar';
      }
    });
  }

  setupJobShare();
  document.addEventListener('astro:page-load', setupJobShare);
</script>
