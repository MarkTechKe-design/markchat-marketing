---
import MarketingLayout from '@/layouts/MarketingLayout.astro';
import CareersApplicationForm from '@/components/careers/CareersApplicationForm.astro';
---

<MarketingLayout
  title="Position Details — MarkChat Careers"
  description="Explore verified opportunities and apply securely to join MarkChat."
  noindex={true}
>
  <div class="min-h-screen bg-slate-50 py-14 dark:bg-background sm:py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <nav aria-label="Breadcrumb" class="mb-8 text-sm">
        <a href="/careers" class="font-semibold text-blue-700 hover:underline dark:text-blue-300">Careers</a>
        <span class="mx-2 text-slate-400" aria-hidden="true">/</span>
        <span>Position details</span>
      </nav>
      <div id="role-unavailable" class="rounded-3xl border border-border bg-white p-8 dark:bg-surface">
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">Position unavailable</h1>
        <p class="mt-4 text-slate-600 dark:text-slate-300">
          This position is not currently accepting applications. Please check our Careers page for verified opportunities.
        </p>
        <a href="/careers" class="mt-6 inline-flex rounded-xl bg-[#1D4ED8] px-5 py-3 font-semibold text-white">
          Back to Careers
        </a>
      </div>
      <div id="role-active" hidden>
        <header class="mb-10 rounded-3xl border border-border bg-white p-6 dark:bg-surface sm:p-10">
          <p id="role-department" class="text-sm font-semibold text-blue-700 dark:text-blue-300"></p>
          <h1 id="role-title" class="mt-4 text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white sm:text-5xl"></h1>
          <p id="role-location" class="mt-5 text-sm text-slate-600 dark:text-slate-300"></p>
        </header>
        <div class="grid gap-8 lg:grid-cols-12">
          <section class="rounded-3xl border border-border bg-white p-6 dark:bg-surface sm:p-8 lg:col-span-7">
            <h2 class="text-xl font-bold text-slate-900 dark:text-white">About this role</h2>
            <div id="role-description" class="mt-4 whitespace-pre-line text-base leading-relaxed text-slate-700 dark:text-slate-300"></div>
          </section>
          <section id="apply" class="rounded-3xl border border-border bg-white p-6 dark:bg-surface sm:p-8 lg:col-span-5">
            <h2 class="mb-5 text-xl font-bold text-slate-900 dark:text-white">Apply securely</h2>
            <CareersApplicationForm kind="role" />
          </section>
        </div>
      </div>
    </div>
  </div>
</MarketingLayout>

<script>
  async function hydrateCurrentRole() {
    const match = window.location.pathname.match(/^\/careers\/([a-z0-9-]+)\/?$/);
    const slug = match?.[1];
    if (!slug || slug === 'position') return;
    try {
      const response = await fetch('/api/careers/roles/' + slug, {
        cache: 'no-store',
        headers: { Accept: 'application/json' },
      });
      if (!response.ok) return;
      const data = await response.json();
      const role = data?.success === true ? data.role : null;
      if (!role || typeof role.id !== 'string' ||
          !/^[0-9a-f-]{36}$/i.test(role.id) ||
          typeof role.title !== 'string' ||
          typeof role.description !== 'string' ||
          typeof role.department !== 'string' ||
          typeof role.location !== 'string') return;
      const form = document.querySelector<HTMLFormElement>('[data-career-application-form]');
      if (!form) return;
      form.dataset.roleId = role.id;
      const setText = (id: string, value: string) => {
        const element = document.getElementById(id);
        if (element) element.textContent = value;
      };
      setText('role-title', role.title);
      setText('role-department', role.department);
      setText('role-location', role.location + ' · ' + String(role.workArrangement || ''));
      setText('role-description', role.description);
      const unavailable = document.getElementById('role-unavailable');
      const active = document.getElementById('role-active');
      if (unavailable && active) {
        unavailable.hidden = true;
        active.hidden = false;
      }
    } catch {
      // Never render application form on missing or failed backend authorization.
    }
  }
  hydrateCurrentRole();
</script>
