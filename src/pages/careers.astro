---
/**
 * MarkChat Kenya — Careers & Open Positions
 *
 * Professional, modern Careers page following the Virex design language:
 * - Compelling mission-aligned hero
 * - CMS-driven company benefits & culture values
 * - Filterable job listings directory with live vacancy count
 * - Polished empty state
 * - Talent pool status notice while CV uploads are disabled
 * - Full dark mode parity (dark:bg-background)
 */
import MarketingLayout from '@/layouts/MarketingLayout.astro';
import { Icon } from 'astro-icon/components';
import { siteConfig } from '@/config';
import { fetchCareersContent, type Career } from '@/lib/cms-api';
import CareersEditorialHero from '@/components/careers/CareersEditorialHero.astro';
import CareerApplicationNotice from '@/components/careers/CareerApplicationNotice.astro';

// Static builds cannot establish current recruitment authorization. Never publish
// bundled or cached roles as actual vacancies without a trusted runtime feed.
const careers: Career[] = [];
const content = await fetchCareersContent();

// Distinct departments and work arrangements for filtering
const departments = [...new Set(careers.map((j) => j.department))];
const workArrangements = ['All', 'Hybrid', 'Remote', 'On-site'];

// Department accent colors
const DEPT_ACCENTS: Record<string, { bg: string; text: string; border: string }> = {
  Engineering: {
    bg: 'bg-indigo-50 dark:bg-indigo-950/70',
    text: 'text-indigo-600 dark:text-indigo-400',
    border: 'border-indigo-200/80 dark:border-indigo-800/80',
  },
  'Customer Operations': {
    bg: 'bg-emerald-50 dark:bg-emerald-950/70',
    text: 'text-emerald-600 dark:text-emerald-400',
    border: 'border-emerald-200/80 dark:border-emerald-800/80',
  },
  'Developer Relations': {
    bg: 'bg-cyan-50 dark:bg-cyan-950/70',
    text: 'text-cyan-600 dark:text-cyan-400',
    border: 'border-cyan-200/80 dark:border-cyan-800/80',
  },
  'Growth & Sales': {
    bg: 'bg-purple-50 dark:bg-purple-950/70',
    text: 'text-purple-600 dark:text-purple-400',
    border: 'border-purple-200/80 dark:border-purple-800/80',
  },
};

const defaultDeptAccent = {
  bg: 'bg-blue-50 dark:bg-blue-950/70',
  text: 'text-blue-600 dark:text-blue-400',
  border: 'border-blue-200/80 dark:border-blue-800/80',
};
---

<MarketingLayout
  title={`Careers & Open Roles — ${siteConfig.name}`}
  description="Join MarkChat in Nairobi. Help build the future of business conversations, in-chat Safaricom M-Pesa payments, and cultural AI for African commerce."
>
  <div
    class="py-14 sm:py-20 bg-slate-50 dark:bg-background min-h-screen transition-colors duration-200"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      {/* =============================================================== */}
      {/* 1. HERO SECTION                                                 */}
      {/* =============================================================== */}
      <section class="mb-20 grid items-center gap-10 sm:mb-24 lg:grid-cols-12 lg:gap-12">
        <div class="min-w-0 lg:col-span-6">
          <p class="mb-4 text-sm font-semibold text-[#1D4ED8] dark:text-blue-300">
            Careers at MarkChat
          </p>
          <h1
            class="text-4xl font-extrabold leading-tight tracking-tight text-slate-900 dark:text-white sm:text-5xl lg:text-6xl"
          >
            {content.heroHeadline}
          </h1>
          <p class="mt-5 max-w-xl text-lg leading-relaxed text-slate-600 dark:text-slate-300">
            {content.heroSubtitle}
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a
              href="#open-positions"
              class="inline-flex items-center justify-center gap-2 rounded-xl bg-[#1D4ED8] px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-blue-800"
            >
              {content.heroCtaText}
              <Icon name="lucide:arrow-down" class="size-4" aria-hidden="true" />
            </a>
            <a
              href="#general-application"
              class="inline-flex items-center justify-center rounded-xl border border-slate-300 bg-white px-6 py-3 text-sm font-semibold text-slate-800 transition-colors hover:border-blue-700 dark:border-slate-700 dark:bg-surface dark:text-slate-100 dark:hover:border-blue-400"
            >
              Talent Pool Updates
            </a>
          </div>
        </div>
        <CareersEditorialHero className="min-w-0 lg:col-span-6" />
      </section>

      {/* =============================================================== */}
      {/* 2. WHY WORK AT MARKCHAT (CMS-DRIVEN BENEFITS)                   */}
      {/* =============================================================== */}
      <section class="mb-20 sm:mb-24">
        <div class="max-w-2xl mb-10">
          <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white tracking-tight">
            {content.whyWorkTitle}
          </h2>
          <p class="mt-2 text-sm sm:text-base text-slate-600 dark:text-slate-400">
            {content.whyWorkSubtitle}
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
          {
            content.benefits.map((benefit) => (
              <div class="p-6 sm:p-8 rounded-2xl bg-white dark:bg-surface border border-border shadow-lg shadow-slate-900/5 dark:shadow-black/20 motion-safe:transform-gpu motion-safe:transition-transform motion-safe:duration-200 motion-safe:hover:-translate-y-1 flex flex-col justify-between">
                <div>
                  <div class="w-12 h-12 rounded-xl flex items-center justify-center bg-blue-50 dark:bg-blue-950/70 border border-blue-200/80 dark:border-blue-800/80 text-blue-600 dark:text-blue-400 mb-5">
                    <Icon name={benefit.icon} class="w-6 h-6" />
                  </div>
                  <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-2">
                    {benefit.title}
                  </h3>
                  <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
                    {benefit.description}
                  </p>
                </div>
              </div>
            ))
          }
        </div>
      </section>

      {/* =============================================================== */}
      {/* 3. OPERATING PRINCIPLES & VALUES                                */}
      {/* =============================================================== */}
      <section
        class="mb-20 sm:mb-24 p-5 sm:p-10 rounded-2xl bg-white dark:bg-surface border border-border"
      >
        <div class="max-w-2xl mb-10">
          <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white tracking-tight">
            {content.valuesTitle}
          </h2>
          <p class="mt-2 text-sm sm:text-base text-slate-600 dark:text-slate-400">
            {content.valuesSubtitle}
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          {
            content.values.map((val) => (
              <div class="p-5 rounded-xl bg-slate-50 dark:bg-surface border border-border dark:border-border flex flex-col justify-between">
                <div>
                  <span class="inline-block px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-blue-100/80 dark:bg-blue-950/80 text-blue-700 dark:text-blue-300 mb-3">
                    {val.tag}
                  </span>
                  <h3 class="text-base font-bold text-slate-900 dark:text-white mb-2">
                    {val.title}
                  </h3>
                  <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
                    {val.description}
                  </p>
                </div>
              </div>
            ))
          }
        </div>
      </section>

      {/* =============================================================== */}
      {/* 4. OPEN POSITIONS DIRECTORY WITH REAL-TIME FILTERS              */}
      {/* =============================================================== */}
      <section id="open-positions" class="mb-20 sm:mb-24 scroll-mt-28">
        <div
          class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-8 border-b border-border dark:border-border pb-6"
        >
          <div>
            <h2
              class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white tracking-tight"
            >
              {content.openPositionsTitle}
            </h2>
            <p class="mt-2 text-sm sm:text-base text-slate-600 dark:text-slate-400">
              {content.openPositionsSubtitle}
            </p>
          </div>
          <div class="text-xs font-semibold text-slate-500 dark:text-slate-400 shrink-0">
            <span id="vacancy-counter" aria-live="polite"
              >Showing {careers.length} open {careers.length === 1 ? 'position' : 'positions'}</span
            >
          </div>
        </div>

        <div class="mb-8 space-y-4" hidden={careers.length === 0}>
          <div
            class="flex flex-wrap items-center gap-2"
            role="group"
            aria-label="Filter by department"
          >
            {
              [
                { label: 'All departments', value: '' },
                ...departments.map((name) => ({ label: name, value: name })),
              ].map(({ label, value }) => (
                <button
                  type="button"
                  data-filter-dept={value}
                  aria-pressed={value === '' ? 'true' : 'false'}
                  class="min-w-0 cursor-pointer rounded-xl border border-border bg-white px-3 py-2 text-sm font-semibold text-slate-700 wrap-break-word transition-colors hover:border-blue-600 aria-pressed:border-[#1D4ED8] aria-pressed:bg-[#1D4ED8] aria-pressed:text-white dark:bg-surface dark:text-slate-200 dark:aria-pressed:bg-[#1D4ED8] dark:aria-pressed:text-white"
                >
                  {label}
                </button>
              ))
            }
          </div>

          <div class="grid gap-3 sm:grid-cols-[minmax(0,12rem)_minmax(0,18rem)]">
            <div class="relative min-w-0">
              <label for="filter-arrangement" class="sr-only">Filter by Arrangement</label>
              <select
                id="filter-arrangement"
                class="w-full px-3 py-2 rounded-xl bg-white dark:bg-surface border border-border dark:border-border text-xs font-medium text-slate-700 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-blue-500"
              >
                {
                  workArrangements.map((arrangement) => (
                    <option value={arrangement}>
                      {arrangement === 'All' ? 'All Arrangements' : arrangement}
                    </option>
                  ))
                }
              </select>
            </div>

            <div class="relative min-w-0">
              <label for="career-search-input" class="sr-only">Search roles</label>
              <input
                type="search"
                id="career-search-input"
                placeholder="Search roles..."
                class="w-full pl-8 pr-3 py-2 rounded-xl bg-white dark:bg-surface border border-border dark:border-border text-xs text-slate-900 dark:text-white placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500"
              />
              <Icon
                name="lucide:search"
                class="w-3.5 h-3.5 absolute left-2.5 top-1/2 -translate-y-1/2 text-slate-400"
              />
            </div>
          </div>
        </div>

        {/* Vacancies Grid */}
        <div id="vacancies-grid" class="space-y-4">
          {
            careers.map((job) => {
              const deptAccent = DEPT_ACCENTS[job.department] || defaultDeptAccent;
              const arrangement = job.workArrangement || 'Hybrid';
              const experience = job.experienceLevel || job.experience || 'Mid-Level';

              return (
                <article
                  data-job-card
                  data-title={job.title.toLowerCase()}
                  data-department={job.department}
                  data-arrangement={arrangement}
                  class="p-5 sm:p-6 rounded-2xl bg-white dark:bg-surface border border-border hover:border-blue-500/50 shadow-lg shadow-slate-900/5 dark:shadow-black/20 motion-safe:transform-gpu motion-safe:transition-transform motion-safe:duration-200 motion-safe:hover:-translate-y-1 group flex flex-col lg:flex-row lg:items-center justify-between gap-6"
                >
                  <div class="flex-1 min-w-0">
                    {/* Badges Row */}
                    <div class="flex flex-wrap items-center gap-2 mb-2.5">
                      <span
                        class:list={[
                          'inline-block px-2.5 py-0.5 rounded-md text-[10px] font-bold uppercase tracking-wider border',
                          deptAccent.bg,
                          deptAccent.text,
                          deptAccent.border,
                        ]}
                      >
                        {job.department}
                      </span>
                      <span class="inline-block px-2 py-0.5 rounded-md text-[10px] font-medium bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300">
                        {arrangement}
                      </span>
                      <span class="inline-block px-2 py-0.5 rounded-md text-[10px] font-medium bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300">
                        {job.type}
                      </span>
                      {job.featured && (
                        <span class="inline-block px-2 py-0.5 rounded-md text-[10px] font-bold uppercase tracking-wider bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20">
                          Featured
                        </span>
                      )}
                    </div>

                    {/* Role Title */}
                    <h3 class="text-lg sm:text-xl font-bold text-slate-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors mb-2">
                      <a href={`/careers/${job.slug || job.id}`} class="hover:underline">
                        {job.title}
                      </a>
                    </h3>

                    {/* Short Description */}
                    <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 line-clamp-2 mb-3 leading-relaxed">
                      {job.shortDescription || job.description}
                    </p>

                    {/* Metadata Footer */}
                    <div class="flex flex-wrap items-center gap-4 text-xs text-slate-600 dark:text-slate-400">
                      <span class="flex items-center gap-1">
                        <Icon name="lucide:map-pin" class="w-3.5 h-3.5 text-slate-400" />
                        <span>{job.location}</span>
                      </span>
                      {job.salaryRange && (
                        <span class="flex items-center gap-1 font-mono text-slate-700 dark:text-slate-300 font-medium">
                          <Icon name="lucide:credit-card" class="w-3.5 h-3.5 text-emerald-500" />
                          <span>{job.salaryRange}</span>
                        </span>
                      )}
                      <span>Exp: {experience}</span>
                    </div>
                  </div>

                  {/* Actions Column */}
                  <div class="shrink-0 flex items-center lg:flex-col lg:items-end justify-between gap-3 pt-4 lg:pt-0 border-t lg:border-t-0 border-border dark:border-border">
                    <a
                      href={`/careers/${job.slug || job.id}`}
                      class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-blue-50 dark:bg-blue-950/70 border border-blue-200/80 dark:border-blue-800/80 text-blue-700 dark:text-blue-300 text-xs font-semibold hover:bg-blue-600 hover:text-white transition-all shadow-none"
                    >
                      <span>View Role &amp; Apply</span>
                      <Icon name="lucide:arrow-right" class="w-3.5 h-3.5" />
                    </a>
                  </div>
                </article>
              );
            })
          }
        </div>

        {/* Empty State when filters yield 0 results */}
        <div
          id="vacancies-empty-state"
          hidden={careers.length > 0}
          class="text-center py-16 px-4 bg-white dark:bg-surface rounded-2xl border border-border"
        >
          <div
            class="w-14 h-14 mx-auto mb-4 rounded-xl bg-blue-50 dark:bg-blue-950/70 border border-blue-200 dark:border-blue-800 flex items-center justify-center text-blue-600 dark:text-blue-400"
          >
            <Icon name="lucide:briefcase" class="w-7 h-7" />
          </div>
          <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-1">
            No Open Positions at the Moment
          </h3>
          <p class="text-sm text-slate-500 dark:text-slate-400 max-w-md mx-auto mb-5">
            We're not currently recruiting, but we're always building towards what's next.
            Thank you for your interest in joining MarkChat. Please check back here for future opportunities.
          </p>
          {careers.length > 0 && (
            <button
              type="button"
              id="reset-vacancies-btn"
              class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-blue-600 text-white font-semibold text-xs shadow-none hover:bg-blue-700 transition-colors"
            >
              <Icon name="lucide:rotate-ccw" class="w-3.5 h-3.5" />
              <span>Reset Filters</span>
            </button>
          )}
        </div>
      </section>

      <section
        id="general-application"
        class="grid min-w-0 scroll-mt-28 gap-6 rounded-3xl bg-[#1D4ED8] p-4 text-white sm:p-8 lg:grid-cols-12 lg:gap-8"
      >
        <div class="px-2 py-3 sm:px-0 lg:col-span-4">
          <p class="mb-3 text-sm font-semibold text-blue-100">Talent Pool</p>
          <h2 class="text-2xl font-bold tracking-tight sm:text-3xl">{content.generalAppTitle}</h2>
          <p class="mt-3 text-sm leading-relaxed text-blue-50 sm:text-base">
            General applications are currently closed. Please check back here for future opportunities.
          </p>
        </div>
        <div
          class="min-w-0 rounded-2xl border border-blue-700/15 bg-white p-4 text-slate-900 shadow-lg shadow-blue-950/20 dark:border-slate-800 dark:bg-surface dark:text-white sm:p-6 lg:col-span-8"
        >
          <CareerApplicationNotice kind="talent" />
        </div>
      </section>
    </div>
  </div>
</MarketingLayout>

<script>
  function initCareerFilters() {
    const positions = document.getElementById('open-positions');
    if (!positions || positions.dataset.bound) return;
    positions.dataset.bound = 'true';

    const departmentButtons = Array.from(
      positions.querySelectorAll<HTMLButtonElement>('[data-filter-dept]')
    );
    const arrangement = positions.querySelector<HTMLSelectElement>('#filter-arrangement');
    const search = positions.querySelector<HTMLInputElement>('#career-search-input');
    const cards = positions.querySelectorAll<HTMLElement>('[data-job-card]');
    const counter = positions.querySelector<HTMLElement>('#vacancy-counter');
    const empty = positions.querySelector<HTMLElement>('#vacancies-empty-state');
    const reset = positions.querySelector<HTMLButtonElement>('#reset-vacancies-btn');
    let department = '';

    function filterRoles() {
      const query = search?.value.toLowerCase().trim() ?? '';
      const selectedArrangement = arrangement?.value ?? 'All';
      let count = 0;
      for (const card of cards) {
        const matches =
          (!department || card.dataset.department === department) &&
          (selectedArrangement === 'All' || card.dataset.arrangement === selectedArrangement) &&
          (!query ||
            [card.dataset.title, card.dataset.department].some((value) =>
              value?.toLowerCase().includes(query)
            ));
        card.hidden = !matches;
        if (matches) count++;
      }
      if (counter)
        counter.textContent = `Showing ${count} open ${count === 1 ? 'position' : 'positions'}`;
      if (empty) empty.hidden = count > 0;
    }

    function selectDepartment(value: string) {
      department = value;
      for (const button of departmentButtons) {
        button.setAttribute('aria-pressed', String(value === button.dataset.filterDept));
      }
      filterRoles();
    }

    for (const button of departmentButtons) {
      button.addEventListener('click', () => selectDepartment(button.dataset.filterDept ?? ''));
    }
    arrangement?.addEventListener('change', filterRoles);
    search?.addEventListener('input', filterRoles);
    reset?.addEventListener('click', () => {
      if (search) search.value = '';
      if (arrangement) arrangement.value = 'All';
      selectDepartment('');
      departmentButtons[0]?.focus();
    });
    filterRoles();
  }

  initCareerFilters();
  document.addEventListener('astro:page-load', initCareerFilters);
</script>
