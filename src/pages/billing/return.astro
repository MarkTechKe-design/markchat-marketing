---
/**
 * MarkChat Payment Return & Verification Handler
 *
 * Consumes Paystack redirect parameters (?reference=...&trxref=...),
 * verifies transaction settlement, and provides one-click Chatwoot SSO launch.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import { siteConfig } from '@/config';

const controlPlaneUrl =
  import.meta.env.PUBLIC_CONTROL_PLANE_URL ||
  import.meta.env.PUBLIC_CONTROL_PLANE_API_URL ||
  'http://localhost:5000';
---

<BaseLayout
  title={`Payment Settlement — ${siteConfig.name} Kenya`}
  description="Verification and settlement status for your MarkChat subscription payment."
>
  <div
    class="min-h-screen w-full flex items-center justify-center bg-surface dark:bg-background relative overflow-hidden px-4 py-12 transition-colors duration-200"
    data-api-url={controlPlaneUrl}
    id="return-container"
  >
    <div class="w-full max-w-lg relative z-10">
      <div
        class="p-8 rounded-xl border border-border bg-background dark:bg-surface shadow-none text-center"
      >
        <!-- Brand Emblem -->
        <div
          class="mx-auto w-12 h-12 rounded-xl bg-primary flex items-center justify-center text-white font-extrabold text-lg shadow-none mb-6"
        >
          M
        </div>

        <!-- 1. Verification In Progress State -->
        <div id="state-verifying" class="space-y-4">
          <div
            class="w-12 h-12 mx-auto border-4 border-primary/20 border-t-primary rounded-full animate-spin"
          >
          </div>
          <h1 class="text-2xl font-bold text-text">Verifying Transaction...</h1>
          <p class="text-sm text-text-muted">
            Reconciling your payment with Paystack & Safaricom M-Pesa. Please keep this window open.
          </p>
        </div>

        <!-- 2. Success State -->
        <div id="state-success" class="hidden space-y-6">
          <div
            class="w-16 h-16 mx-auto rounded-full bg-emerald-100 dark:bg-emerald-950/60 border border-emerald-300 dark:border-emerald-700 flex items-center justify-center text-emerald-600 dark:text-emerald-400"
          >
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2.5"
                d="M5 13l4 4L19 7"></path>
            </svg>
          </div>
          <div>
            <h1 class="text-2xl font-extrabold text-text">Payment Settled!</h1>
            <p class="text-sm text-text-muted mt-1">
              Payment confirmed by the Control Plane. Workspace provisioning and access may still be
              finishing.
            </p>
          </div>

          <!-- Receipt Details -->
          <div
            class="p-4 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700 text-left text-xs space-y-2"
          >
            <div class="flex justify-between">
              <span class="text-slate-500">Transaction Reference:</span>
              <span id="receipt-ref" class="font-mono font-bold text-slate-800 dark:text-slate-200"
              ></span>
            </div>
            <div class="flex justify-between">
              <span class="text-slate-500">Amount Paid:</span>
              <span id="receipt-amount" class="font-bold text-slate-800 dark:text-slate-200"></span>
            </div>
            <div class="flex justify-between">
              <span class="text-slate-500">Payment Status:</span>
              <span class="font-bold text-emerald-600 dark:text-emerald-400 uppercase"
                >Payment confirmed</span
              >
            </div>
          </div>

          <a
            href="/"
            id="launch-workspace-btn"
            class="block w-full py-3.5 px-6 rounded-xl bg-primary text-white font-bold hover:bg-primary-hover transition-colors shadow-none text-sm"
          >
            Launch MarkChat Workspace &rarr;
          </a>
        </div>

        <div id="state-pending" class="hidden space-y-4" role="status">
          <h1 class="text-2xl font-bold text-text">Confirmation is still processing</h1>
          <p id="pending-reason" class="text-sm text-text-muted">
            Your payment has not yet been confirmed. We will not activate your workspace until the
            Control Plane confirms it.
          </p>
          <a id="pending-resume" href="/register" class="inline-block text-primary underline"
            >Return to registration</a
          >
        </div>

        <!-- 3. Failed / Abandoned State -->
        <div id="state-failed" class="hidden space-y-6">
          <div
            class="w-16 h-16 mx-auto rounded-full bg-rose-100 dark:bg-rose-950/60 border border-rose-300 dark:border-rose-700 flex items-center justify-center text-rose-600 dark:text-rose-400"
          >
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2.5"
                d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </div>
          <div>
            <h1 class="text-2xl font-extrabold text-text">Payment Incomplete</h1>
            <p id="failed-reason" class="text-sm text-text-muted mt-1">
              Your payment could not be confirmed or was cancelled.
            </p>
          </div>

          <div class="flex gap-3">
            <a
              href="/billing"
              class="flex-1 py-3 px-4 rounded-xl bg-primary text-white font-semibold text-sm hover:bg-primary-hover transition-colors"
            >
              Retry Payment
            </a>
            <a
              href="/login"
              class="flex-1 py-3 px-4 rounded-xl border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-200 font-semibold text-sm hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
            >
              Go to Workspace
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  const container = document.getElementById('return-container');
  const apiUrl = container?.dataset.apiUrl || 'http://localhost:5000';
  const stateVerifying = document.getElementById('state-verifying');
  const stateSuccess = document.getElementById('state-success');
  const stateFailed = document.getElementById('state-failed');
  const statePending = document.getElementById('state-pending');
  const pendingReason = document.getElementById('pending-reason');
  const receiptRef = document.getElementById('receipt-ref');
  const receiptAmount = document.getElementById('receipt-amount');
  const launchBtn = document.getElementById('launch-workspace-btn') as HTMLAnchorElement;
  const failedReason = document.getElementById('failed-reason');
  const pendingResume = document.getElementById('pending-resume') as HTMLAnchorElement;
  const urlParams = new URLSearchParams(window.location.search);
  const pendingRaw = sessionStorage.getItem('markchat_verification_pending');
  let pending: { registrationId: string; reference: string; createdAt: number } | null = null;
  try {
    const saved = pendingRaw ? JSON.parse(pendingRaw) : null;
    if (
      saved &&
      typeof saved.registrationId === 'string' &&
      typeof saved.reference === 'string' &&
      Number.isFinite(saved.createdAt) &&
      Date.now() - saved.createdAt < 24 * 60 * 60 * 1000
    ) {
      pending = saved;
    }
  } catch {
    sessionStorage.removeItem('markchat_verification_pending');
  }
  // Paystack returns reference or trxref. A stored reference supports a manual check
  // after a callback URL is missing; URL values never authorize Core access.
  const reference =
    urlParams.get('reference') || urlParams.get('trxref') || pending?.reference || null;
  const isVerification = !!pending && pending.reference === reference;

  function reveal(which: 'success' | 'failed' | 'pending') {
    stateVerifying?.classList.add('hidden');
    stateSuccess?.classList.toggle('hidden', which !== 'success');
    stateFailed?.classList.toggle('hidden', which !== 'failed');
    statePending?.classList.toggle('hidden', which !== 'pending');
  }
  function showPending(message: string) {
    if (pendingReason) pendingReason.textContent = message;
    if (pendingResume) pendingResume.href = isVerification ? '/register' : '/billing';
    reveal('pending');
  }
  function showFailed(message: string) {
    if (failedReason) failedReason.textContent = message;
    reveal('failed');
  }
  function showConfirmed(tx: { reference: string; amountKesCents: number; purpose: string }) {
    if (receiptRef) receiptRef.textContent = tx.reference;
    if (receiptAmount)
      receiptAmount.textContent = `KES ${(tx.amountKesCents / 100).toLocaleString()}`;
    // Never navigate directly to an untrusted ssoUrl returned with a receipt.
    if (launchBtn) launchBtn.href = '/login';
    sessionStorage.removeItem('markchat_reg_idempotency_key');
    if (isVerification) sessionStorage.removeItem('markchat_verification_pending');
    const heading = document.querySelector('#state-success h1');
    if (heading)
      heading.textContent = isVerification
        ? 'Account confirmation received'
        : 'Subscription payment confirmed';
    reveal('success');
  }

  async function readRegistrationStatus(registrationId: string) {
    const response = await fetch(
      `${apiUrl}/api/v1/registration/${encodeURIComponent(registrationId)}`,
      {
        headers: { Accept: 'application/json' },
        cache: 'no-store',
      }
    );
    if (!response.ok) return null;
    const payload = await response.json();
    return payload.data || payload;
  }

  async function checkStatus() {
    if (!reference || !/^[a-zA-Z0-9_-]{8,100}$/.test(reference)) {
      showFailed(
        'No valid transaction reference was found. Please return to your registration or billing page.'
      );
      return;
    }
    const token = localStorage.getItem('markchat_cp_token');
    const headers: Record<string, string> = { Accept: 'application/json' };
    if (token) headers.Authorization = `Bearer ${token}`;
    const maxAttempts = 20;
    for (let attempts = 0; attempts < maxAttempts; attempts++) {
      try {
        const res = await fetch(`${apiUrl}/api/v1/billing/status/${reference}`, {
          headers,
          cache: 'no-store',
        });
        if (res.ok) {
          const body = await res.json();
          const tx = body.transaction || body.data?.transaction;
          if (tx && (tx.status === 'success' || tx.status === 'settled')) {
            if (isVerification) {
              if (tx.purpose !== 'account_verification' || tx.amountKesCents !== 8200) {
                showFailed('The returned payment does not match the KES 82 account confirmation.');
                return;
              }
              const statusData = await readRegistrationStatus(pending!.registrationId);
              if (statusData?.status === 'completed') {
                showConfirmed(tx);
                return;
              }
              if (statusData?.status === 'failed') {
                showPending(
                  'Your payment was confirmed, but workspace setup needs support. Do not pay again.'
                );
                return;
              }
              if (attempts === maxAttempts - 1) {
                showPending(
                  'KES 82 payment confirmed. Your selected plan is being provisioned. Do not pay again; return later to check workspace setup.'
                );
                return;
              }
            } else {
              if (tx.purpose !== 'subscription') {
                showFailed(
                  'This payment is not a subscription transaction associated with this billing session.'
                );
                return;
              }
              showConfirmed(tx);
              return;
            }
          }
          if (tx && (tx.status === 'failed' || tx.status === 'abandoned')) {
            showFailed(
              `Payment was ${tx.status}. No subscription or verification activation has been confirmed.`
            );
            return;
          }
        }
      } catch {
        // Temporary network errors are not payment confirmation.
      }
      await new Promise<void>((resolve) => setTimeout(resolve, 1500));
    }
    showPending(
      'Payment confirmation is taking longer than expected. Do not pay twice; you can revisit this page to check the reference.'
    );
  }
  void checkStatus();
</script>
