---
/**
 * MarkChat Customer Registration Page
 *
 * Implements the minimal, distraction-free AuthLayout built directly on BaseLayout.
 * Centered Virex card UI with native semantic OKLCH tokens and two-step registration wizard.
 */
import AuthLayout from '@/layouts/AuthLayout.astro';
import RegisterForm from '@/components/forms/RegisterForm.astro';
import { siteConfig } from '@/config';

const url = new URL(Astro.request.url);
const requestedPlan = url.searchParams.get('plan') || 'growth';
const selectedPlan = ['starter', 'growth', 'scale'].includes(requestedPlan)
  ? requestedPlan
  : 'growth';
const interval = url.searchParams.get('interval') === 'annual' ? 'annual' : 'monthly';
---

<AuthLayout
  title={`Create Account — ${siteConfig.name} Kenya`}
  description="Verify your email, choose a MarkChat Core plan, and create your workspace with the current trial and payment terms."
  pageType="register"
>
  <div class="max-w-xl mx-auto w-full">
    <!-- Centered Header with Title & Subheadline -->
    <div class="text-center mb-8">
      <h1 class="text-2xl sm:text-3xl font-bold text-text tracking-tight">
        Create your MarkChat Workspace
      </h1>
      <p class="mt-2 text-sm text-text-muted">
        Verify your email and choose Starter, Growth, or Scale. We will confirm the current trial
        and payment terms before you create your workspace.
      </p>
    </div>

    <!-- Virex Card Container -->
    <div class="bg-surface border border-border rounded-2xl shadow-sm p-6 sm:p-8">
      <RegisterForm
        defaultPlanId={selectedPlan}
        billingInterval={interval}
        redirectUrl={`/billing?plan=${selectedPlan}&interval=${interval}`}
      />
    </div>
  </div>
</AuthLayout>
